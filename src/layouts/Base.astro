---
import { existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import { ClientRouter } from 'astro:transitions';
import config from 'virtual:mori/config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { lang, clientJson } from '../lib/i18n.ts';
import { isPresetIcon } from '../lib/site-icon.mjs';
import Lightbox from '../components/Lightbox.astro';
import SearchPanel from '../components/SearchPanel.astro';

import '../../fonts/EBGaramond/font.css';
import '@fontsource/special-elite/latin-400.css';
import '../styles/mori.css';

// 东观体 fontLoad: 'sync'：三个字重的样式表在 <head> 里同步载入，常规和粗体里最常用的字块（c- 开头）预加载
const STD = ['regular', 'light', 'bold'];
const stdPreload = config.fontLoad === 'sync'
  ? ['regular', 'bold'].flatMap((w) => {
      const dir = join(process.cwd(), 'public/fonts/STD', w);
      return existsSync(dir) ? readdirSync(dir).filter((f) => /^c-.*\.woff2$/.test(f)).map((f) => `/fonts/STD/${w}/${f}`) : [];
    })
  : [];

interface Props {
  title?: string;
  description?: string;
  /** 首页 / 归档页的排法（h 横排 / v 竖排）；文章页不设 */
  direction?: 'h' | 'v';
  /** 文章页的 og:type 等 */
  type?: 'website' | 'article';
  /** 文章、页面的 posts/<id>、pages/<id>：用来记阅读量 */
  entry?: string;
  /** 整屏的页面（地图）：不要页脚 */
  bare?: boolean;
}
const { title, description = config.description || config.title, direction, type = 'website', entry, bare } = Astro.props;
// 阅读量、在线访客记在自建评论服务里
const stats = config.comments?.provider === 'mori' ? config.comments.endpoint : undefined;
const fullTitle = title ? `${title} · ${config.title}` : config.title;
const canonical = config.site ? new URL(Astro.url.pathname, config.site).href : undefined;
// 站点图标：预设走 /favicon.svg，自己的图直接链接（public/ 里）
const iconHref = isPresetIcon(config.icon) ? '/favicon.svg' : config.icon;
const iconType = ({ svg: 'image/svg+xml', png: 'image/png', ico: 'image/x-icon', jpg: 'image/jpeg', jpeg: 'image/jpeg', webp: 'image/webp' } as Record<string, string>)[iconHref.split('.').pop()!.toLowerCase()];
---

<!doctype html>
<!-- 主题色：写在 <html> 的自定义属性上（base.css 里有默认值），行内样式的优先级最高，不靠谁排在后面 -->
<html lang={lang} data-hdir={direction} data-hdir-cfg={direction} data-spoiler={config.spoiler} style={{ '--accent-base': config.accent, '--accent-dark': config.accentDark }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:type" content={type} />
    {description && <meta property="og:description" content={description} />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={iconHref} type={iconType} />
    <!-- 东观体：@font-face 有四百多条（unicode-range 切片），放进首屏样式表要多传两百多 KB，字体文件本身也要几百 KB。
         所以首屏先用系统的宋体，页面 load 之后再载入东观体（单独成文件，在 public/fonts/ 下）。
         换页时 Astro 会删掉新页面 <head> 里没有的元素，所以换页前把这几个 <link> 抄进新页面，它就认作同一个、原样留着 -->
    {config.fontLoad === 'sync' ? (
      <>
        {stdPreload.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
        {STD.map((w) => <link rel="stylesheet" href={`/fonts/STD/${w}/font.css`} data-font-std={w} />)}
      </>
    ) : (
    <script is:inline>
      (() => {
        const load = () => {
          for (const w of ['regular', 'light', 'bold']) {
            if (document.querySelector(`link[data-font-std="${w}"]`)) continue;
            const l = document.createElement('link');
            l.rel = 'stylesheet';
            l.href = `/fonts/STD/${w}/font.css`;
            l.dataset.fontStd = w;
            document.head.append(l);
          }
        };
        document.addEventListener('astro:before-swap', (e) => {
          for (const l of document.querySelectorAll('link[data-font-std]')) e.newDocument.head.append(l.cloneNode());
        });
        if (document.readyState === 'complete') setTimeout(load, 0);
        else addEventListener('load', () => setTimeout(load, 0), { once: true });
      })();
    </script>
    )}
    <link rel="alternate" type="application/rss+xml" title={config.title} href="/feed" />
    <!-- 昼夜：先于首次绘制，避免闪一下；换页时 <html> 的属性会被换掉，所以每次换页后再补上 -->
    <script is:inline>
      (() => {
        const apply = () => {
          try {
            const t = localStorage.getItem('mori-theme');
            if (t) document.documentElement.dataset.theme = t;
          } catch {}
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <!-- 首页 / 归档的排法：设置里可选横排或竖排，但手机（窄屏）上一律横排。
         data-hdir-cfg 是设置的值，data-hdir 是当前生效的；先于首次绘制，跨过断点（旋转屏幕）和换页后都重新判断 -->
    <script is:inline>
      (() => {
        const mq = matchMedia('(max-width: 760px)');
        const apply = () => {
          const el = document.documentElement, cfg = el.dataset.hdirCfg;
          if (!cfg) return; // 文章页等没有排法设置
          const want = mq.matches ? 'h' : cfg;
          if (el.dataset.hdir !== want) el.dataset.hdir = want;
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
        // 两个都听：媒体查询的 change 事件在有的环境里不可靠，resize 兜底。这段脚本先于页面上其他 resize 处理注册，所以它们看到的已经是新值
        mq.addEventListener('change', () => { apply(); dispatchEvent(new Event('resize')); });
        addEventListener('resize', apply);
      })();
    </script>
    <!-- 首页整页第一次打开时播进场动画：先于首次绘制加上 intro，初始状态由 CSS 接手，不会先闪一下成品；intro-go 由 home.ts 在封面图解码后加上，脚本没跑起来时 2.5 秒后兜底放行 -->
    <script is:inline>
      (() => {
        const el = document.documentElement;
        if (location.pathname !== '/' || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        el.classList.add('intro');
        setTimeout(() => el.classList.add('intro-go'), 2500);
      })();
    </script>
    <script type="application/json" id="mori-i18n" is:inline set:html={clientJson} />
    <slot name="head" />
    <ClientRouter />
    <!-- 设定里填的自定义代码（统计脚本之类）：只放进构建出来的站点 -->
    {import.meta.env.PROD && config.head && <Fragment set:html={config.head} />}
  </head>
  <body data-stats={stats} data-entry={stats && entry}>
    <Header />
    <slot />
    {!bare && <Footer />}
    <Lightbox />
    <SearchPanel />
    <script>
      import '../scripts/chrome.ts';
      import '../scripts/code.ts';
      import '../scripts/embed.ts';
      import '../scripts/lightbox.ts';
      import '../scripts/live.ts';
      import '../scripts/search.ts';
      import '../scripts/stats.ts';
    </script>
  </body>
</html>
