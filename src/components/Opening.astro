---
import Chevron from './Chevron.astro';
/**
 * 首页“引文开篇”（spec §2 · F 期刊·引文版）：左侧窄栏（本期特稿 + 目录）+ 舞台（封面图，引文压在图上）+ 篇名信息。
 * 置顶可以有好几篇，由读者点左边目录切换；只有一篇时没有目录，就是一张静止的封面。
 */
import { Image } from 'astro:assets';
import type { Entry } from '../lib/entries.ts';
import { dotDate, pad2, pad3 } from '../lib/zh.ts';
import { t, fmt } from '../lib/i18n.ts';

interface Props {
  pinned: Entry[];
  /** 最新一篇，决定“第几期 / 哪年哪季” */
  latest: Entry;
}
const { pinned, latest } = Astro.props;
const many = pinned.length > 1;
/** 分类的中英名：两个一样、或英文名留空时只写一个，不拼出“游记 · 游记”“游记 · ” */
const catName = (c: { zh: string; en?: string }) => [...new Set([c.zh, c.en].filter(Boolean))].join(' · ');
const ld = latest.data.date;

/** 每篇置顶要有：封面、引文、图注、三条信息；缺哪样就用文章自己的字段顶上。引文和摘要都没有就不放引文，封面也不做渐隐 */
const slides = pinned.map((e) => {
  const d = e.data, pin = d.pin;
  const own = (pin?.quote ?? []).filter((l) => l.trim());
  const lines = own.length ? own : [d.excerpt].filter((l) => l.trim()); // 置顶没写引言就用摘要，摘要也没有就没有引文
  let i = 0;
  const quote = lines.map((l, n) => [...((n === 0 ? '「' : '') + l + (n === lines.length - 1 ? '」' : ''))].map((ch) => ({ ch, i: i++ })));
  return {
    e,
    image: pin?.image ?? d.cover,
    alt: pin?.alt ?? d.coverAlt ?? '',
    quote,
    /** 引文的行数、最长一行的字数（含「」）：引文字号按这两个数缩到放得进封面图（opening.css） */
    lines: quote.length,
    n: Math.max(0, ...quote.map((l) => l.length)),
    caption: pin?.caption ?? `${e.category.zh} · ${dotDate(d.date)}`,
    meta: pin?.meta ?? [{ label: t('home.date'), value: dotDate(d.date) }],
  };
});
const first = slides[0];
const dt = 'mb-1 text-meta leading-[1.6] tracking-[.12em] text-muted-foreground';
---

<section class="wrap fo pt-[clamp(36px,8vh,110px)] pb-[clamp(64px,13vh,160px)] narrow:pt-0" id="fo">
  <div class="g">
    <div class="fo-side meta col-[1/3] row-1 flex flex-col gap-[5px] pt-[.5em] text-muted-foreground narrow:row-2 narrow:mt-[26px] narrow:flex-row narrow:flex-wrap narrow:items-baseline narrow:gap-x-3.5 narrow:gap-y-1 narrow:p-0">
      <span class="mb-3 text-primary narrow:m-0">{t('home.feature')}</span>
      <b class="mb-2.5 text-num leading-none font-light tracking-[0] text-foreground narrow:m-0 narrow:text-heading" id="fo-no">{pad3(first.e.n)}</b>
      {/* 各篇的分类叠在一格里、只显示当前一篇：占的地方按最长的算，换篇时下面的目录不会因为分类名折行而跳 */}
      <span class="grid" id="fo-cat">{slides.map((s, k) => <span class:list={['[grid-area:1/1]', k !== 0 && 'invisible']}>{catName(s.e.category)}</span>)}</span>
      <span>{fmt.yearSeason(ld)}</span>
      {
        many && (
          <div class="fo-more mt-[clamp(28px,5vh,48px)] narrow:mt-[22px] narrow:basis-full" id="fo-more">
            <ol class="flex flex-col">
              {slides.map((s, k) => (
                <li class="group/li relative border-t border-t-border after:absolute after:top-[-1px] after:left-0 after:h-px after:w-0 after:bg-primary after:[transition:width_.65s_cubic-bezier(.22,1,.36,1)] after:content-[''] aria-[current]:after:w-full" aria-current={k === 0 ? 'true' : undefined}>
                  <button class="group/btn flex w-full items-baseline gap-3 pt-[13px] pb-3.5 text-left font-serif" type="button" data-i={k}>
                    <b class="mb-2.5 min-w-[1.7em] flex-none narrow:m-0 text-item leading-none font-light tracking-[0] text-muted-foreground transition-[color] duration-400 group-hover/btn:text-primary group-aria-[current]/li:text-primary">{pad3(s.e.n)}</b>
                    <span class="text-body leading-[1.45] tracking-[.03em] text-muted-foreground transition-[color] duration-400 group-hover/btn:text-foreground group-aria-[current]/li:text-foreground">{s.e.data.title}</span>
                  </button>
                </li>
              ))}
            </ol>
          </div>
        )
      }
    </div>
    <div class="col-[3/13] row-1 grid">
      <div class="flex min-w-0 flex-col [grid-area:1/1] narrow:-mx-(--gut) narrow:-mt-[53px]" id="fo-stage" role="region" aria-label={t('home.region')}>
        {/* 各篇叠在一起，共用三行：封面（引文压在上面）、图注、篇名栏。行高取各篇里最高的，换篇时图注和篇名栏不会因为某一篇的图注折行而跳 */}
        <div class="grid grid-rows-[auto_auto_auto]" id="fo-track">
          {
            slides.map((s, k) => (
              <article class:list={['fo-slide col-1 row-[1/4] grid min-w-0 grid-rows-subgrid', k === 0 && 'on']} data-no={pad3(s.e.n)} inert={k !== 0}>
                <figure class:list={['fo-cover col-1 row-[1/3] grid grid-rows-subgrid', s.lines === 0 && 'plain']}>
                  <div class="ph">
                    {s.image && <Image class="absolute inset-0 size-full object-cover [filter:saturate(.9)] dark:[filter:saturate(.9)_brightness(.8)]" src={s.image} alt={s.alt} widths={[800, 1200, 1600, 2000]} sizes="(max-width: 760px) 100vw, 83vw" loading={k === 0 ? 'eager' : 'lazy'} fetchpriority={k === 0 ? 'high' : 'auto'} />}
                  </div>
                  <figcaption class="meta mt-5 flex items-baseline justify-between gap-4 narrow:px-(--gut)">
                    <span>{s.caption}</span>
                    {many && <span>{pad2(k + 1)} / {pad2(slides.length)}</span>}
                  </figcaption>
                </figure>
                {s.lines > 0 && (
                  <a class="group/qa relative z-2 col-1 row-1 flex h-(--ph-h) max-w-[min(100%,800px)] items-center self-start justify-self-start pl-[clamp(16px,3vw,48px)] vert:justify-self-end vert:pl-0 vert:pr-[clamp(8px,1.4vw,24px)] narrow:items-end narrow:pt-0! narrow:pr-0! narrow:pb-[46px]! narrow:pl-[1em]!" href={s.e.href} style={{ '--lines': s.lines, '--n': s.n }}>
                    <p class="fo-q indent-[-1em] leading-[1.6] font-light tracking-[.05em] transition-[color] duration-500 group-hover/qa:text-soft-foreground vert:leading-[2] vert:[writing-mode:vertical-rl]">
                      {s.quote.map((line, n) => (
                        <Fragment>
                          {n > 0 && <br />}
                          {line.map(({ ch, i }) => <span class="ch" style={{ '--i': i }}>{ch}</span>)}
                        </Fragment>
                      ))}
                    </p>
                  </a>
                )}
                <dl class="fo-cite col-1 row-3 mt-[clamp(22px,4vh,44px)] grid content-start grid-flow-col grid-cols-[1.3fr_1fr_1fr_1.4fr_auto] grid-rows-[auto_auto] max-[1000px]:grid-cols-[1.3fr_1fr_auto] items-start gap-x-(--gap) gap-y-1 bg-[linear-gradient(var(--foreground),var(--foreground))] bg-[position:0_0] bg-[size:100%_1px] bg-no-repeat pt-4 narrow:grid-cols-[1fr_auto] narrow:bg-[position:var(--gut)_0] narrow:bg-[size:calc(100%_-_2*var(--gut))_1px] narrow:px-(--gut)">
                  <div class="contents"><dt class={dt}>{t('home.title')}</dt><dd class="w-fit self-baseline text-heading leading-[1.3] tracking-[.06em] text-balance">{s.e.data.title}</dd></div>
                  {s.meta.map((m, i) => <div class:list={['contents narrow:hidden', i > 0 && 'max-[1000px]:hidden']}><dt class={dt}>{m.label}</dt><dd class="self-baseline text-aux leading-[1.6] text-balance">{m.value}</dd></div>)}
                  <a class="row-start-2 self-baseline text-aux whitespace-nowrap [&_.chev]:text-primary [&_.chev]:[transition:transform_.5s_var(--ease-mori)] hover:[&_.chev]:[transform:translateX(5px)]" href={s.e.href}>{t('home.readMore')}<Chevron /></a>
                </dl>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
