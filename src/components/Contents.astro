---
import Chevron from './Chevron.astro';
/** 目次（spec §2，作者认可）：左边大字“目次 / Contents”和编者按，右边按分类分组。
 *  东观体的「目」左边自带约 .23em 的空白，横排时往左拉 .21em，让笔画和下面的 Contents 对齐；
 *  竖排时「目」顶上约留 .1em，Contents 往下挪 .28em（它自己的字号）对齐 */
import config from 'virtual:mori/config';
import { pinsOf, type Entry } from '../lib/entries.ts';
import { numDate, pad3 } from '../lib/zh.ts';
import { t, tn, fmt } from '../lib/i18n.ts';

interface Props {
  entries: Entry[];
  latest: Entry;
}
const { entries } = Astro.props;
/** 每个分类里置顶的排在前面（按 pin.order），其余照旧按新到旧 */
const pinnedFirst = (list: Entry[]) => [...pinsOf(list), ...list.filter((e) => !e.data.pin)];
const ROMAN = ['Ⅰ', 'Ⅱ', 'Ⅲ', 'Ⅳ', 'Ⅴ', 'Ⅵ', 'Ⅶ', 'Ⅷ', 'Ⅸ', 'Ⅹ'];
const sections = config.categories
  .map((c) => ({ c, list: pinnedFirst(entries.filter((e) => e.category.id === c.id)) }))
  .filter((s) => s.list.length)
  .map((s, i) => ({ ...s, roman: ROMAN[i] ?? String(i + 1) }));
---

<section class="wrap fcon pt-[clamp(56px,11vh,128px)] pb-[clamp(40px,8vh,96px)]" data-dir={config.home.tocDirection}>
  <div class="g border-t border-t-border pt-[clamp(40px,7vh,88px)]">
    <aside class="sticky top-[110px] col-[1/5] self-start narrow:static narrow:mb-14 tocv:flex tocv:flex-row-reverse tocv:justify-end tocv:gap-10">
      <h2 class="text-giant leading-none font-normal tracking-[.12em] tocv:[writing-mode:vertical-rl]">{t('toc.sub') ? <span class="inline-block -ml-[.21em] tocv:ml-0">{t('toc.title')}</span> : t('toc.title')}{t('toc.sub') && <em class="mt-[.35em] block text-[.3em] font-light tracking-[.01em] text-muted-foreground tocv:m-0 tocv:mt-[.28em] tocv:mr-[.4em]">{t('toc.sub')}</em>}</h2>
      {config.home.editorNote && <p class="mt-11 max-w-[14.5em] text-aux leading-[1.95] text-soft-foreground tocv:mt-0 tocv:h-[15em] tocv:max-w-none tocv:[writing-mode:vertical-rl]"><span class="meta mb-2 block text-primary">{t('toc.editor')}</span>{config.home.editorNote}</p>}
    </aside>
    <div class="col-[6/13]">
      {
        sections.map(({ c, list, roman }) => (
          <section class="f-sec group/sec mb-[clamp(44px,8vh,88px)]">
            <a class="f-sh group/sh grid grid-cols-[4.4em_1fr_auto] items-center gap-x-[18px] bg-[linear-gradient(var(--foreground),var(--foreground))] bg-[position:0_100%] bg-[size:0_1px] bg-no-repeat pb-3 [transition:background-size_1.3s_var(--ease-mori)] group-[.in]/sec:bg-[size:100%_1px] narrow:grid-cols-[3.2em_1fr_auto]" href={`/category/${c.id}/`}>
              <span class="text-heading leading-[.9] font-light">{roman}</span>
              <span class="flex items-baseline gap-4">
                <h3 class="text-heading font-normal tracking-[.14em] transition-[color] duration-300 group-hover/sh:text-primary">{c.zh}</h3>
                <em class="text-item font-light text-muted-foreground ">{c.en}</em>
              </span>
              <span class="meta transition-[color] duration-300 group-hover/sh:text-primary">{tn('count', list.length, { n: fmt.num(list.length) })}<Chevron /></span>
            </a>
            <ol>
              {list.map((e) => (
                <li>
                  <a class="group/en grid grid-cols-[4.4em_1fr_auto] items-center gap-x-[18px] border-b border-b-border pt-[17px] pb-[19px] narrow:grid-cols-[3.2em_1fr]" href={e.href}>
                    <span class="text-heading leading-none font-light transition-[color] duration-300 group-hover/en:text-primary">{pad3(e.n)}</span>
                    <span class="w-fit bg-[linear-gradient(currentColor,currentColor)] bg-[position:0_100%] bg-[size:0_1px] bg-no-repeat text-lead leading-[1.4] tracking-[.04em] [transition:background-size_.6s_var(--ease-mori)] group-hover/en:bg-[size:100%_1px]">{e.data.title}</span>
                    <span class="meta narrow:col-2">{e.data.pin && <span class="mr-2.5 text-primary">{t('home.pinned')}</span>}{numDate(e.data.date)}</span>
                    <span class="ex col-2 mt-1.5 text-aux leading-[1.8] tracking-[.03em] text-muted-foreground">{e.data.excerpt}</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </div>
</section>
