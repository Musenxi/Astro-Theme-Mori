---
/** 文章、页面、文章目录共用的页头：标题，下面一行附属信息（分类 · 日期 · 篇幅），可选的副题。有封面时照片放在这些下面 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  /** 附属信息，用 · 连起来；带 href 的是链接 */
  meta?: (string | { label: string; href: string })[];
  sub?: string;
  cover?: ImageMetadata;
  coverAlt?: string;
}
const { title, meta = [], sub, cover, coverAlt = '' } = Astro.props;
---

<header class="wrap g pt-[clamp(48px,9vw,120px)] pb-[clamp(40px,5.5vw,72px)] *:col-[3/11]">
  <h1 class="w-fit text-title leading-[1.25] font-normal tracking-[.06em] [view-transition-name:title-post]">{title}</h1>
  {sub && <p class="mt-3 text-item leading-[1.6] tracking-[.04em] text-soft-foreground">{sub}</p>}
  {
    meta.length > 0 && (
      <p class="meta mt-5 flex flex-wrap items-baseline gap-x-2.5">
        {meta.map((m, i) => (
          <>
            {i > 0 && <span aria-hidden="true">·</span>}
            {typeof m === 'string' ? <span>{m}</span> : <a class="transition-[color] duration-300 hover:text-primary" href={m.href}>{m.label}</a>}
          </>
        ))}
      </p>
    )
  }
  {
    cover && (
      <figure class="col-[2/12]! mt-[clamp(32px,4.5vw,60px)] h-[clamp(300px,56vh,600px)] overflow-hidden narrow:col-[1/-1]!">
        <Image class="size-full object-cover [filter:saturate(.92)] dark:[filter:saturate(.9)_brightness(.85)]" src={cover} alt={coverAlt} widths={[800, 1200, 1600, 2000]} sizes="(max-width: 760px) 100vw, 83vw" loading="eager" fetchpriority="high" />
      </figure>
    )
  }
</header>
