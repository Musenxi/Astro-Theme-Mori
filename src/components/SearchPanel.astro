---
import { t } from '../lib/i18n.ts';
/** 悬浮搜索：全站都在，点页头的搜索入口、按 ⌘K / Ctrl+K 或 / 打开（scripts/search.ts）。没有脚本时搜索入口照常进 /search/ */
---

<dialog class="srch-panel fixed inset-0 m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 text-foreground backdrop:bg-transparent" id="srch-panel" aria-label={t('search.title')}>
  <svg class="absolute" width="0" height="0" aria-hidden="true"><defs data-defs></defs></svg>
  <div class="srch-veil absolute inset-0 bg-[color-mix(in_srgb,var(--background)_38%,transparent)] transition-opacity duration-300 starting:opacity-0" data-close></div>
  <div class="srch-box lg lg-panel relative mx-auto mt-[clamp(56px,13vh,140px)] flex max-h-[min(640px,calc(100svh-clamp(56px,13vh,140px)-24px))] w-[min(640px,calc(100vw-32px))] flex-col overflow-hidden [transition:opacity_.3s,transform_.45s_var(--ease-mori)] starting:opacity-0 starting:[transform:translateY(-8px)_scale(.985)]" data-srch>
    <label class="flex flex-none items-center gap-3.5 border-b border-b-border px-6 py-4.5">
      <svg class="size-5 flex-none text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m15.5 15.5 5 5"></path></svg>
      <span class="sr-only">{t('search.title')}</span>
      <input class="min-w-0 flex-1 appearance-none border-0 bg-transparent text-item leading-[1.5] tracking-[.05em] text-inherit [font-family:inherit] [outline:0] placeholder:text-muted-foreground [&::-webkit-search-cancel-button]:hidden" data-q type="search" placeholder={t('search.title')} autocomplete="off" />
      <span class="meta" data-note></span>
    </label>
    <ol class="min-h-0 overflow-y-auto overscroll-contain px-6 empty:hidden" data-list></ol>
  </div>
</dialog>
