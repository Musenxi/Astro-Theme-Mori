---
/**
 * 长卷的两个角落控件（玻璃）：右下角读法切换（竖 / 横 / 混），左下角当前位置（开着地图、正文里标了地点才有）。
 * 读者选读法并被记住；作者只决定默认值和允许哪几种（reading.default / allowed）。
 */
import type { Flow } from '../lib/flow.ts';
import MiniMap from './MiniMap.astro';
import { t } from '../lib/i18n.ts';
import { coord } from '../lib/geo.ts';

interface Props {
  allowed: Array<'v' | 'h' | 'm'>;
  /** 正文里的地点、区域和路线（没开地图就不给） */
  flow?: Pick<Flow, 'places' | 'regions' | 'trip'>;
}
const { allowed, flow } = Astro.props;
const stops = flow?.places ?? [];
const LABEL = { v: [t('travel.mode.v'), t('travel.modeLabel.v')], h: [t('travel.mode.h'), t('travel.modeLabel.h')], m: [t('travel.mode.m'), t('travel.modeLabel.m')] } as const;
const stopData = stops.map((s) => ({ id: s.id, name: s.name || coord(s.lnglat), date: s.date ?? '' }));
---

<svg class="absolute" width="0" height="0" aria-hidden="true"><defs id="lg-defs-t"></defs></svg>

{
  allowed.length > 1 && (
    <div class="lg lg-btn fixed right-[18px] bottom-[18px] z-20 flex flex-col p-[3px] [transition:transform_.6s_var(--ease-mori),opacity_.4s,background-color_.4s,box-shadow_.4s] narrow:right-3 narrow:bottom-3" id="mc" role="group" aria-label={t('travel.readingGroup')} data-modes={allowed.join(',')}>
      <i class="lg-lens lg-lens-v" aria-hidden="true" />
      {allowed.map((m) => <button class="relative z-1 size-[30px] rounded-[999px] text-aux text-(--lg-fg) transition-[color] duration-400 hover:text-(--lg-fg-on) aria-pressed:text-(--lg-fg-on)" type="button" data-m={m} aria-label={LABEL[m][1]}>{LABEL[m][0]}</button>)}
    </div>
  )
}

{stops.length > 0 && <div class="lg lg-btn fixed bottom-[18px] left-[18px] z-20 flex items-center gap-3 py-2 pr-5 pl-3.5 opacity-0 pointer-events-none [transform:translateY(12px)] [transition:transform_.6s_var(--ease-mori),opacity_.4s,background-color_.4s,box-shadow_.4s] narrow:bottom-3 narrow:left-3 [&.on]:pointer-events-auto [&.on]:opacity-100 [&.on]:[transform:none]" id="loc" data-stops={JSON.stringify(stopData)}>
  <div class="relative aspect-[1000/720] w-[60px] flex-none overflow-hidden rounded-[8px]">
    <MiniMap flow={flow!} />
  </div>
  <div class="leading-[1.35] whitespace-nowrap">
    <span class="mono text-muted-foreground narrow:hidden" id="rb-n">01 / {String(stops.length).padStart(2, '0')}</span>
    <b class="block text-aux font-normal" id="rb-name">{stopData[0].name}</b>
  </div>
</div>}
