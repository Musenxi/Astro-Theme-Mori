---
import { Image } from 'astro:assets';
import type { Inline, PostData } from '../schema/schema.ts';
import { numberNotes, renderInline, sideRefs } from '../lib/inline.ts';
import { axisOf } from '../lib/flow.mjs';
import { t, vertical } from '../lib/i18n.ts';

interface Props {
  blocks: PostData['blocks'];
  notes: PostData['notes'];
}
const { blocks, notes } = Astro.props;
const numbers = numberNotes(blocks);
const html = (spans: Inline) => renderInline(spans, numbers);

let fig = 0;
/** 正文栏：第 3–8 栏，右边再放出三个字宽（窄屏占满一行，不放） */
const main = 'col-[3/9] -mr-(--main-plus) narrow:mr-0';
const p = 'mb-[1.1em] text-justify text-pretty';
const li = "relative py-[.2em] pl-[1.6em] text-pretty before:absolute before:top-[1.12em] before:left-[.1em] before:h-px before:w-[.6em] before:bg-muted-foreground before:content-['']";

/** 竖滚里竖排的块：挨着的几个竖排块排成一个竖排的框（和长卷竖向读法里的竖排列一样）；二级标题另起一个 */
/** 文字块在竖滚里的对齐（Studio 的排版里设；不写是各块自己的默认） */
const al = (b: object) => axisOf(b as never, 'v').align as string | undefined;
const pos = (b: object) => axisOf(b as never, 'v').pos as string | undefined;
const isV = (b: { type: string }) => vertical && ['p', 'h', 'quote', 'list'].includes(b.type) && axisOf(b, 'v').writing === 'v';
type Item = { group: typeof blocks } | { b: (typeof blocks)[number] };
const items: Item[] = [];
for (const b of blocks) {
  const last = items.at(-1);
  if (!isV(b)) items.push({ b });
  else if (last && 'group' in last && !(b.type === 'h' && b.level !== 3)) last.group.push(b);
  else items.push({ group: [b] });
}
const vcol = 'col-[2/10] my-[1.6em] h-[min(21em,64vh)] max-w-full justify-self-end overflow-x-auto overflow-y-hidden tracking-[.12em] leading-[2.05] [scrollbar-width:thin] [writing-mode:vertical-rl]';
const vgap = '[margin-block-start:.9em] first:[margin-block-start:0]';
const footnotes = [...numbers.foot].map(([ref, n]) => ({ ref, n, text: notes[ref]?.text ?? [] }));
---

<article class="wrap g prose pb-20 in-data-[page=page]:pb-6">
  {
    items.map((it) => {
      // 单独一个竖排引用照旧（下面 quote 那一支）；其余竖排块成组
      if ('group' in it && !(it.group.length === 1 && it.group[0].type === 'quote')) {
        const notes_ = it.group.flatMap((g) => (g.type === 'p' ? sideRefs(g.text) : []));
        return (
          <Fragment>
          <div class={vcol} data-vcol data-pos={it.group.map(pos).find(Boolean)}>
            {it.group.map((g) => {
              switch (g.type) {
                case 'h': return g.level === 3
                  ? <h3 class={`${vgap} font-bold tracking-[.08em] scroll-mt-(--toc-top)`} id={g.id} data-b={g.id} data-align={al(g)} set:html={html(g.text)} />
                  : <h2 class={`${vgap} text-chapter font-bold tracking-[.18em] scroll-mt-(--toc-top) [margin-block-end:.8em]`} id={g.id} data-b={g.id} data-align={al(g)} set:html={html(g.text)} />;
                case 'quote': return (
                  <blockquote class={`${vgap} border-r border-r-primary pr-[1.1em] text-heading text-foreground`} data-b={g.id} data-align={al(g)}>
                    <Fragment set:html={html(g.text)} />
                    {g.cite && <cite class="block text-meta text-muted-foreground [margin-block-start:.4em]" data-skip>{g.cite}</cite>}
                  </blockquote>
                );
                case 'list': {
                  const Tag = g.ordered ? 'ol' : 'ul';
                  return <Tag class={`${vgap} [counter-reset:li]`} data-b={g.id}>{g.items.map((item) => <li class="[counter-increment:li] before:text-muted-foreground before:content-['・']" set:html={html(item)} />)}</Tag>;
                }
                default: return <p class={`${vgap} text-justify`} data-b={g.id} data-align={al(g)} set:html={html((g as { text: Inline }).text)} />;
              }
            })}
          </div>
          {notes_.length > 0 && (
            <div class="col-[3/9] flex flex-col gap-[.9em] [margin-block-end:1.4em]">
              {notes_.map((ref) => (
                <aside class="border-t border-t-border pt-[.35em] text-meta leading-[1.75] text-muted-foreground" id={`note-${ref}`}>
                  <sup class="nref" data-skip>{numbers.side.get(ref)}</sup>
                  <Fragment set:html={html(notes[ref]?.text ?? [])} />
                </aside>
              ))}
            </div>
          )}
          </Fragment>
        );
      }
      const b = 'group' in it ? it.group[0] : it.b;
      switch (b.type) {
        case 'p': {
          const refs = sideRefs(b.text);
          return refs.length ? (
            <div class="col-[3/13] grid grid-cols-subgrid narrow:block">
              <p class={`col-[1/7] -mr-(--main-plus) narrow:mr-0 ${p}`} data-b={b.id} data-align={al(b)} set:html={html(b.text)} />
              <div class="col-[8/11] flex flex-col gap-[.9em] narrow:mt-[-.4em] narrow:mb-[1.4em]">
                {refs.map((ref) => (
                  <aside class="border-t border-t-border pt-[.35em] text-meta leading-[1.75] text-muted-foreground narrow:pt-[.5em]" id={`note-${ref}`}>
                    <sup class="nref" data-skip>{numbers.side.get(ref)}</sup>
                    <Fragment set:html={html(notes[ref]?.text ?? [])} />
                  </aside>
                ))}
              </div>
            </div>
          ) : (
            <p class={`${main} ${p}`} data-b={b.id} data-align={al(b)} set:html={html(b.text)} />
          );
        }
        case 'h': {
          if (b.level === 3) return <h3 class={`${main} scroll-mt-(--toc-top)`} id={b.id} data-b={b.id} data-align={al(b)} set:html={html(b.text)} />;
          return (
            <h2 class={`${main} mt-[2.6em] mb-[.9em] scroll-mt-(--toc-top) text-chapter leading-[1.5] font-bold tracking-[.08em]`} id={b.id} data-b={b.id} data-align={al(b)}>
              <Fragment set:html={html(b.text)} />
            </h2>
          );
        }
        case 'quote': {
          const vq = axisOf(b, 'v').writing === 'v' && vertical;
          return (
            <blockquote class:list={[main, !vq && "relative my-[1.6em] px-[4.2em] py-[.3em] text-center text-heading leading-[2.1] text-foreground before:absolute before:top-[-.1em] before:left-0 before:w-[.5em] before:text-[6em] before:leading-none before:text-foreground/20 before:[font-family:'Special_Elite',Georgia,serif] before:content-['“'] narrow:px-[1.6em] narrow:before:text-[2.6em]", vq && 'mt-[1.4em] mb-[2.2em] h-[12.5em] justify-self-center border-r border-r-primary pr-[1.1em] text-heading leading-[2.1] tracking-[.2em] text-foreground [writing-mode:vertical-rl]']} data-b={b.id} data-align={al(b)}>
              <Fragment set:html={html(b.text)} />
              {b.cite && <cite class={vq ? 'block text-end text-meta text-muted-foreground  [margin-block-start:.4em]' : 'mt-[.6em] block text-center text-meta text-muted-foreground'} data-skip>{b.cite}</cite>}
            </blockquote>
          );
        }
        case 'image': {
          fig += 1;
          return (
            <figure class:list={['rv mt-[2em] mb-[2.4em]', b.layout === 'inline' ? `inline ${main}` : 'col-[2/12]']} data-b={b.id}>
              <Image class="aspect-video w-full cursor-zoom-in object-cover" src={b.src} alt={b.alt} widths={[640, 960, 1280, 1600]} sizes="(max-width: 760px) 100vw, 83vw" />
              {b.caption && (
                <figcaption class="mt-2.5 flex items-baseline gap-3 text-meta text-muted-foreground">
                  <span class="mono flex-none">{t('fig', { n: fig })}</span>
                  {b.caption}
                </figcaption>
              )}
            </figure>
          );
        }
        case 'list': {
          const Tag = b.ordered ? 'ol' : 'ul';
          return (
            <Tag class={`${main} mb-[1.2em]`} data-b={b.id}>
              {b.items.map((item) => <li class={li} set:html={html(item)} />)}
            </Tag>
          );
        }
        case 'code':
          return (
            <pre class={`${main} mt-[.4em] mb-[1.6em] overflow-x-auto rounded-[6px] bg-muted px-[22px] py-[18px] text-soft-foreground [font:calc(var(--text-body)*.8)/1.8_var(--font-mono)]`} data-b={b.id} data-lang={b.lang}><code>{b.code}</code></pre>
          );
      }
    })
  }
  {
    footnotes.length > 0 && (
      <section class={`fns ${main} mt-[3.2em] text-aux leading-[1.8] text-muted-foreground before:mb-[1.1em] before:block before:h-px before:w-12 before:bg-border before:content-['']`} aria-label={t('notes.foot')}>
        <ol class="grid gap-[.5em]">
          {footnotes.map((f) => (
            <li class="flex items-baseline gap-[.7em] text-pretty" id={`fn-${f.ref}`}>
              <sup class="nref mr-0">{f.n}</sup>
              <span set:html={html(f.text)} />
            </li>
          ))}
        </ol>
      </section>
    )
  }
</article>
