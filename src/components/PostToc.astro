---
/**
 * 文章目录：宽屏时放在正文右边，跟着滚动停在上方；当前读到的那一节用主题色标出（scripts/toc.ts）。
 * 叠在正文上面的一层同样的 12 栏网格，占第 10–12 栏，和旁注同一栏（旁注经过时目录隐去）；小标题少于两个、或窄屏时不出现。
 */
import type { PostData } from '../schema/schema.ts';
import { plainText } from '../lib/inline.ts';
import { pad2 } from '../lib/zh.ts';
import { t } from '../lib/i18n.ts';

interface Props {
  blocks: PostData['blocks'];
}
const { blocks } = Astro.props;

let h2 = 0;
const items = blocks.flatMap((b) => (b.type === 'h' ? [{ id: b.id, level: b.level, n: b.level === 2 ? ++h2 : 0, text: plainText(b.text) }] : []));
---

{
  items.length >= 2 && (
    <div class="wrap g pointer-events-none absolute inset-0 max-lg:hidden" data-toc>
      <nav class="col-[10/13]" aria-label={t('post.toc')}>
        <ol class="pointer-events-auto sticky top-(--toc-top) border-l border-l-border transition-opacity duration-300 [&.off]:pointer-events-none [&.off]:opacity-0">
          {items.map((it) => (
            <li>
              <a
                class:list={[
                  '-ml-px flex items-baseline gap-2 border-l border-l-transparent py-[.3em] pr-2 text-meta leading-[1.6] tracking-[.04em] text-muted-foreground [transition:color_.3s,border-color_.3s] hover:text-foreground aria-[current=location]:border-l-primary aria-[current=location]:text-foreground',
                  it.level === 2 ? 'pl-3.5' : 'pl-7',
                ]}
                href={`#${it.id}`}
              >
                {it.level === 2 && <span class="leading-none">{pad2(it.n)}</span>}
                {it.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>
  )
}
