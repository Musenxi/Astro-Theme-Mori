---
/**
 * 长卷版式的文章：封面（开着地图时是标题、事实、路线图；没开是和别的文章一样的页头）+ 正文各列。
 * 由文章页（pages/posts/[slug].astro）在文章开了地图、设了读法或用了长卷的块时使用。
 */
import { t, vertical } from '../lib/i18n.ts';
import TravelBody from './TravelBody.astro';
import PostHeader from './PostHeader.astro';
import RouteMap from './RouteMap.astro';
import type { Entry } from '../lib/entries.ts';
import type { PostData } from '../schema/schema.ts';
import type { Flow } from '../lib/flow.ts';
import { readingOf } from '../lib/inline.ts';
import { numDate } from '../lib/zh.ts';

interface Props { entry: Entry; flow: Flow }
const { entry, flow } = Astro.props;
const d = entry.data as PostData;
// 内容里叫 v / h / mix，样式和脚本里混合读法叫 m
const short = (m: 'v' | 'h' | 'mix') => (m === 'mix' ? 'm' : m) as 'v' | 'h' | 'm';
const initial = short(flow.reading.default);
const mapped = d.map && (d.mapView?.hero ?? true) && flow.places.length > 0;
const { chars, minutes } = readingOf(d);
---

<article class="travel" data-mode={initial} data-dir={vertical ? flow.reading.direction : 'ltr'}>
  {
    mapped ? (
      <header class="t-hero wrap g items-center gap-y-8 pt-[clamp(28px,5vw,72px)] pb-[clamp(48px,7vw,96px)]">
        <div class="col-[1/6]">
          <h1 class="w-fit text-display leading-[1.15] font-normal tracking-[.06em] [view-transition-name:title-is]">{d.title}</h1>
          <p class="meta mt-5 flex flex-wrap items-baseline gap-x-2"><a class="transition-[color] duration-300 hover:text-primary" href={`/category/${entry.category.id}/`}>{entry.category.zh}</a><span aria-hidden="true">·</span><span>{numDate(d.date)}</span></p>
          <p class="ex mt-6 mb-8 max-w-[24em] text-soft-foreground">{d.excerpt}</p>
          {d.facts.length > 0 && (
            <dl class="grid grid-cols-[auto_1fr] items-baseline gap-x-6 gap-y-2.5 border-t border-t-border pt-5">
              {d.facts.map((f) => <><dt class="meta">{f.label}</dt><dd class="text-body tracking-[.04em] [font-feature-settings:'tnum','lnum']">{f.value}</dd></>)}
              <dt class="meta">{t('travel.stops')}</dt><dd class="text-body tracking-[.04em] [font-feature-settings:'tnum','lnum']">{flow.places.length}</dd>
            </dl>
          )}
        </div>
        <div class="col-[6/13] narrow:-order-1"><RouteMap variant="hero" stops={flow.places} track={d.track} /></div>
      </header>
    ) : (
      <div class="t-hero">
        <PostHeader title={d.title} sub={d.subtitle || undefined} cover={d.cover} coverAlt={d.coverAlt} meta={[{ label: entry.category.zh, href: `/category/${entry.category.id}/` }, numDate(d.date), ...t('post.meta', { chars: chars.toLocaleString('en-US'), min: minutes }).split(' · ')]} />
      </div>
    )
  }
  <TravelBody post={d} flow={flow} />
</article>
