---
/**
 * E 刻度（spec §2）：位置就是时间，一格一个月，空着的地方就是没写东西（或这个分类没更新）的月份。
 * 旁边的大号年月随滚动逐位翻动。横排时时间轴往下走；竖排时像手卷一样从右往左展开，标题竖着挂在轴线下。
 * 归档、分类页、文章列表、游记列表都用它；时间范围总是整站的（这样分类页的空档才有意义）。
 */
import type { Entry } from '../lib/entries.ts';
import { pad2, cnMonthDay } from '../lib/zh.ts';
import { tn, fmt, lang } from '../lib/i18n.ts';

interface Props {
  title: string;
  en?: string;
  /** 要画在轴上的文章 */
  entries: Entry[];
  /** 整站的文章，用来定时间范围 */
  all: Entry[];
  /** 分类页：每一项都在这个分类里，不必在每一行后面再写一遍分类名 */
  hideCategory?: boolean;
}
const { title, en, entries, all, hideCategory = false } = Astro.props;
/** 竖排时的日期：九月十四 */
const monthDay = (d: Date) => (lang === 'en' ? `${pad2(d.getMonth() + 1)}.${pad2(d.getDate())}` : cnMonthDay(d));

const ym = (d: Date) => d.getFullYear() * 12 + d.getMonth(); // 月序数，0 起
const newest = Math.max(...all.map((e) => ym(e.data.date)));
const oldest = Math.min(...all.map((e) => ym(e.data.date)));
const months = Math.max(6, newest - oldest + 1);
const ny = Math.floor(newest / 12), nm = (newest % 12) + 1;

const tick = 'pointer-events-none absolute horiz:left-0 horiz:top-[calc(var(--p)*var(--mh))] horiz:border-t vert:top-[calc(30vh_-_12px)] vert:right-[calc(var(--edge)_+_var(--p)*var(--mw))] vert:border-l';
const tickY = 'horiz:w-10 vert:top-[calc(30vh_-_40px)] vert:h-10 horiz:border-t-foreground vert:border-l-foreground';
const tickI = 'absolute text-meta leading-none whitespace-nowrap ';
const ticks = Array.from({ length: months }, (_, k) => {
  const tm = newest - k, y = Math.floor(tm / 12), m = (tm % 12) + 1;
  return { k, y, m, yearTop: m === 12 || k === 0 };
});
/** 离最新一格往下几格（带小数：同一个月里按日期分布） */
const posOf = (e: Entry) => {
  const d = e.data.date;
  return newest - ym(d) + 1 - (d.getDate() - 1) / 31;
};
---

<header class="wrap pt-[clamp(48px,8vh,96px)]">
  <div class="flex items-baseline gap-4 border-b border-b-border pb-5">
    <h1 class="w-fit text-title leading-[1.25] font-normal tracking-[.08em] [view-transition-name:cat-title]">{title}</h1>
    {en && <em class="text-lead font-light text-muted-foreground ">{en}</em>}
    <span class="meta ml-auto">{tn('count', entries.length, { n: fmt.num(entries.length) })}</span>
  </div>
</header>

<section class="he pt-[clamp(20px,4vh,48px)] pb-10 [--mh:112px] [--mw:150px] narrow:[--mh:92px] narrow:[--mw:120px]" data-ny={ny} data-nm={nm} data-months={months}>
  <div class="horiz:mx-auto horiz:grid horiz:max-w-(--maxw) horiz:grid-cols-[minmax(0,1fr)_auto] horiz:gap-x-(--gap) horiz:px-(--gut) horiz:narrow:grid-cols-1" id="he-body">
    <div class="horiz:contents vert:sticky vert:top-0 vert:h-screen vert:overflow-hidden vert:[direction:rtl]">
      <div class="relative horiz:col-1 horiz:row-2 horiz:h-[calc(var(--months)*var(--mh))] horiz:border-l horiz:border-l-foreground horiz:narrow:row-3 vert:h-full vert:w-[calc(var(--months)*var(--mw)_+_2*var(--edge))] vert:will-change-transform vert:[direction:ltr] vert:before:absolute vert:before:top-[30vh] vert:before:right-(--edge) vert:before:left-(--edge) vert:before:border-t vert:before:border-t-foreground vert:before:content-['']" id="he-axis" style={{ '--months': months }}>
        {
          ticks.map((t) => (
            <>
              <span class:list={[tick, t.yearTop ? tickY : 'horiz:w-3 vert:h-3 horiz:border-t-muted-foreground vert:border-l-muted-foreground']} style={{ '--p': t.k }}>{t.yearTop && <i class:list={[tickI, 'text-meta tracking-[.08em] text-foreground horiz:left-[52px] horiz:top-[-.5em] horiz:narrow:left-1 horiz:narrow:top-[-1.5em] vert:left-1.5 vert:top-0', t.k === 0 && 'vert:max-[900px]:right-1.5 vert:max-[900px]:left-auto']}>{t.y}</i>}</span>
              <span class:list={[tick, 'border-0! horiz:w-3 vert:h-3']} style={{ '--p': t.k }}><i class:list={[tickI, 'text-muted-foreground horiz:left-5 horiz:top-[calc(var(--mh)/2_-_.5em)] vert:top-[-4px] vert:right-[calc(var(--mw)/2_-_1em)] vert:left-auto']}>{pad2(t.m)}</i></span>
            </>
          ))
        }
        {
          entries.map((e) => (
            <a class="he-item group/it absolute flex items-baseline gap-[14px] whitespace-nowrap horiz:top-[var(--q,calc(var(--p)*var(--mh)))] horiz:left-[clamp(96px,12vw,180px)] horiz:[transform:translateY(-50%)] horiz:narrow:left-16 horiz:narrow:max-w-[calc(100%_-_64px)] horiz:narrow:flex-wrap horiz:narrow:gap-x-2.5 horiz:narrow:whitespace-normal vert:top-[calc(30vh_+_22px)] vert:right-[calc(var(--edge)_+_var(--q,calc(var(--p)*var(--mw))))] vert:max-h-[56vh] vert:[writing-mode:vertical-rl] vert:[transform:translateX(50%)]" href={e.href} style={{ '--p': posOf(e).toFixed(3) }}>
              <span class="text-lead tracking-[.06em] transition-[color] duration-300 group-hover/it:text-primary horiz:narrow:basis-full">{e.data.title}</span>
              <span class="meta vert:tracking-[.18em]">{!hideCategory && <>{e.category.zh}<span class="px-1.5">·</span></>}<span class="vert:hidden">{pad2(e.data.date.getMonth() + 1)}.{pad2(e.data.date.getDate())}</span><span class="horiz:hidden">{monthDay(e.data.date)}</span></span>
            </a>
          ))
        }
      </div>
      <div class="pointer-events-none text-giant leading-none font-light tracking-[.01em] whitespace-nowrap text-muted-foreground horiz:sticky horiz:top-[34vh] horiz:col-2 horiz:row-2 horiz:self-start horiz:narrow:hidden vert:absolute vert:bottom-[8vh] vert:left-(--edge) vert:[direction:ltr]" id="he-counter" aria-hidden="true">
        {
          [0, 0, 0, 0, '.', 0, 0].map((d) =>
            d === '.' ? (
              <span class="mx-[.06em] text-primary">·</span>
            ) : (
              <span class="dg inline-block h-[1em] overflow-hidden align-top"><i class="block [transition:transform_.8s_var(--ease-mori)]">{[...'0123456789'].map((x) => <b class="block h-[1em] [font-weight:inherit]">{x}</b>)}</i></span>
            ),
          )
        }
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/scale.ts';
</script>
