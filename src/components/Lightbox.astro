---
import { t } from '../lib/i18n.ts';
/** 看大图（spec §4）：点任意正文图片，图片从原位放大，原来的裁切同步展开；背景是磨砂玻璃 */
---

<div class="lb group/lb fixed inset-0 z-50 grid cursor-zoom-out place-items-center before:absolute before:inset-0 before:bg-(image:--grain) before:bg-lightbox before:opacity-0 before:backdrop-blur-[28px] before:backdrop-saturate-[1.3] before:transition-[opacity] before:duration-[450ms] before:content-[''] [&.on]:before:opacity-100" id="lb" hidden>
  <img class="lb-img relative h-auto max-h-[78vh] w-auto max-w-[min(88vw,1600px)] object-contain will-change-[transform,clip-path]" alt="" />
  <div class="glass absolute bottom-[22px] left-1/2 flex max-w-[calc(100vw_-_32px)] items-baseline gap-3.5 overflow-hidden rounded-[4px] px-4 py-[7px] text-aux text-ellipsis whitespace-nowrap text-soft-foreground opacity-0 [transform:translate(-50%,10px)] [transition:opacity_.4s_ease_.12s,transform_.55s_var(--ease-mori)_.12s] group-[.on]/lb:opacity-100 group-[.on]/lb:[transform:translate(-50%,0)]"><span class="mono" id="lb-n"></span><span id="lb-t"></span><span class="mono lbl ml-1.5">{t('lightbox.close')}</span></div>
</div>
