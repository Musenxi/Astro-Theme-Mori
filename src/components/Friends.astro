---
/** 友人帐：一人一张卡片，头像、名字、一句话；点卡片去对方的站点；每次打开随机排序 */
import { Image } from 'astro:assets';
import { getFriends } from '../lib/pages.ts';
import { t } from '../lib/i18n.ts';

const friends = await getFriends();
const lostFiles = import.meta.glob('/src/content/friends-lost.txt', { query: '?raw', import: 'default', eager: true });
const lost = String(Object.values(lostFiles)[0] ?? '').trim();
---

{
  (friends.length > 0 || lost) && (
    <div class="wrap g pb-24">
    <ul class="col-[3/11] grid grid-cols-2 gap-[clamp(10px,1.4vw,16px)] phone:grid-cols-1 pt-2" data-friends>
      {friends.map((f) => (
        <li>
          <a class="group grid h-[104px] grid-cols-[64px_minmax(0,1fr)] items-center gap-4 rounded-[18px] border border-border px-5 py-3 [transition:border-color_.3s,transform_.5s_var(--ease-mori)] hover:-translate-y-0.5 hover:border-primary" href={f.data.url} target="_blank" rel="noopener">
            <span class="grid size-[64px] flex-none place-items-center overflow-hidden rounded-[50%] bg-muted [transition:transform_.5s_var(--ease-mori)] group-hover:[transform:scale(1.06)] [&_img]:h-full [&_img]:w-full [&_img]:object-cover [&_img]:[filter:grayscale(.35)_contrast(.95)] [&_img]:transition-[filter] [&_img]:duration-400 group-hover:[&_img]:[filter:none]" aria-hidden="true">
              {typeof f.data.avatar === 'string' ? (
                <img src={f.data.avatar} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
              ) : f.data.avatar ? (
                <Image src={f.data.avatar} alt="" width={128} height={128} />
              ) : (
                <b class="text-item font-normal text-muted-foreground">{[...f.data.name][0]}</b>
              )}
            </span>
            <span class="grid min-w-0 gap-[3px] font-[Inter,'PingFang_SC',sans-serif]">
              <span class="truncate text-[14px] font-semibold [transition:color_.3s] group-hover:text-primary">{f.data.name}</span>
              {f.data.desc && <span class="line-clamp-2 overflow-hidden text-[12px] leading-[1.6] text-ellipsis text-soft-foreground">{f.data.desc}</span>}
            </span>
          </a>
        </li>
      ))}
    </ul>
    {lost && (
      <div class="col-[3/11] mt-12">
        <h2 class="mb-3 text-heading">{t('friends.lost')}</h2>
        <pre class="overflow-x-auto rounded-[6px] bg-muted px-[22px] py-[18px] text-soft-foreground [font:13px/1.8_var(--font-mono)]"><code>{lost}</code></pre>
      </div>
    )}
    </div>
  )
}

<script>
  const shuffle = () => {
    const ul = document.querySelector('[data-friends]');
    if (!ul) return;
    const items = [...ul.children];
    for (let i = items.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [items[i], items[j]] = [items[j]!, items[i]!];
    }
    ul.append(...items);
  };
  document.addEventListener('astro:page-load', shuffle);
</script>
