---
/**
 * 长卷版式的正文：把文章的块排成“列”（相邻文字一列，图片、地图各自一块），有竖向、混合、横向三种读法。
 * 读到哪个地点由正文里的地点标记决定：每一列记着自己读到第几个地点（data-place），左下角的“当前位置”和行程表都按它走。
 */
import { Image } from 'astro:assets';
import type { Inline, PostData } from '../schema/schema.ts';
import type { Flow } from '../lib/flow.ts';
import { numberNotes, renderInline } from '../lib/inline.ts';
import { isPlaceOnly } from '../lib/flow.mjs';
import { coord } from '../lib/geo.ts';
import { t, vertical } from '../lib/i18n.ts';
import RouteMap from './RouteMap.astro';

interface Props {
  post: PostData;
  flow: Flow;
}
const { post, flow } = Astro.props;
const { notes, track } = post;
const { places, columns, regions } = flow;
const map = post.map && places.length > 0;
const itinerary = map && (post.mapView?.itinerary ?? true);

// 长卷里旁注和脚注不分栏：都在文末列成“注”，编号统一
const raw = numberNotes(post.blocks);
const all = new Map<string, number>();
for (const [ref] of [...raw.side, ...raw.foot]) if (!all.has(ref)) all.set(ref, all.size + 1);
// 正文里的地点按出现顺序编号（和 flow.places 的顺序一致）；自由排布里的小字不算
const counter = { next: 0 };
const numbers = { side: all, foot: all, place: counter };
const html = (spans: Inline) => renderInline(spans, numbers);
const plainHtml = (spans: Inline) => renderInline(spans, { side: all, foot: all });
const endnotes = [...all].map(([ref, n]) => ({ ref, n, text: notes[ref]?.text ?? [] }));

/** 二级标题上标着的地点（有就把英文名、日期、坐标放在标题旁，和以前站点的标题一样） */
const placeOfBlock = (id: string) => places.find((p) => p.block === id);

// 游记文字块里各种块的样式：横排文字和竖排文字（.v）各一套，渲染时选好，不靠覆盖
const li = 'relative [counter-increment:li]';
const ht = {
  stop: 'mb-3.5',
  no: 'mb-1.5 block text-primary',
  h2: 'mr-3 inline text-chapter font-normal tracking-[.08em]',
  en: 'text-aux text-muted-foreground',
  p: 'text-justify',
  pp: 'mt-[.9em]',
  h3: 'mt-[1.3em] mb-[.5em] text-[1.12em] font-bold tracking-[.08em]',
  quote: "relative my-[1.6em] px-[4.2em] py-[.3em] text-center text-heading leading-[2.1] text-foreground before:absolute before:top-[-.1em] before:left-0 before:w-[.5em] before:text-[6em] before:leading-none before:text-foreground/20 before:[font-family:'Special_Elite',Georgia,serif] before:content-['“'] narrow:px-[1.6em] narrow:before:text-[2.6em]",
  cite: 'mt-[.3em] block text-meta text-muted-foreground',
  ul: 'my-[.9em] [counter-reset:li]',
  ol: 'my-[.9em] [counter-reset:li]',
  uli: `${li} py-[.2em] pl-[1.6em] before:absolute before:top-[1.05em] before:left-0 before:h-px before:w-[.7em] before:bg-muted-foreground before:content-['']`,
  oli: `${li} py-[.2em] pl-[1.6em] before:absolute before:top-[.3em] before:left-0 before:text-meta before:leading-[2] before:text-muted-foreground before:content-[counter(li)]`,
  pre: 'my-[1em] overflow-x-auto rounded-[6px] bg-muted px-[1.1em] py-[.9em] text-soft-foreground [font:.8em/1.75_var(--font-mono)]',
};
const vt = {
  stop: 'm-0 ml-[1.2em]',
  no: 'm-0 ml-[.3em] block font-serif text-meta tracking-[.26em] text-primary',
  h2: 'm-0 block text-chapter font-normal tracking-[.18em]',
  en: 'mr-[.2em] block text-meta tracking-[.04em] text-muted-foreground',
  p: 'text-justify',
  pp: 'm-0 mr-[.9em]',
  h3: 'm-0 mr-[1.1em] text-[1.12em] font-bold tracking-[.08em]',
  quote: 'm-0 mr-[.9em] border-r border-r-primary p-0 pb-[1em] text-soft-foreground',
  cite: 'm-0 mr-[.4em] block text-meta text-muted-foreground ',
  ul: 'm-0 mr-[.9em] [counter-reset:li]',
  ol: 'm-0 mr-[.9em] [counter-reset:li]',
  uli: `${li} border-0 p-0 before:static before:top-[1.05em] before:left-0 before:inline before:h-auto before:w-auto before:bg-transparent before:content-['・']`,
  oli: `${li} border-0 p-0 before:static before:top-[.3em] before:left-0 before:[font-family:inherit] before:text-[1em] before:leading-[inherit] before:text-muted-foreground before:content-[counter(li,cjk-ideographic)_'、']`,
  pre: 'm-0 mt-[.9em] max-h-full w-[22em] overflow-auto rounded-[6px] bg-muted px-[1.1em] py-[.9em] tracking-[0] text-soft-foreground [font:.8em/1.75_var(--font-mono)] [writing-mode:horizontal-tb]',
};


/** 每一列（块）共有的属性：读到第几个地点、位置和缩放 */
const at = (c: { place: number; places: number[] }, y?: number, scale?: number) => ({
  'data-place': c.place >= 0 ? c.place : undefined,
  'data-places': c.places.length ? c.places.join(',') : undefined,
  style: { '--y': y, '--s': scale },
});
---

<div class="t-body">
  <div class="t-vp">
    <div class="t-track">
      {
        columns.map((c) => {
          if (c.kind === 'text') {
            // 同一列在横滚和竖滚里写法不同（比如横滚里竖排、竖滚里横排）就渲染两份，按读法显示其中一份
            const same = c.writing === c.vwriting;
            const start = counter.next;
            return (same ? [{ axis: '', w: c.writing }] : [{ axis: 'h', w: c.writing }, { axis: 'v', w: c.vwriting }]).map((variant) => {
            counter.next = start;
            const v = variant.w === 'v' && vertical;
            const k = v ? vt : ht; // 竖排文字和横排文字的行内块样式不同，渲染时就选好
            return (
              <section class:list={['blk', 'b-text', c.anchor && 'anchor', variant.axis && `ax-${variant.axis}`, v && 'v tracking-[.12em] leading-[2.05] [writing-mode:vertical-rl]']} {...at(c, c.y, c.scale)}>
                {c.blocks.map((b, bi) => {
                  switch (b.type) {
                    case 'h': {
                      if (b.level === 3) return <h3 class={`${k.h3} scroll-mt-(--toc-top)`} id={b.id} data-b={b.id} set:html={html(b.text)} />;
                      const place = placeOfBlock(b.id);
                      return (
                        <header class={k.stop}>
                          {v ? (
                            <>
                              {place?.date && <span class={k.no}>{place.date}</span>}
                              <h2 class={`${k.h2} scroll-mt-(--toc-top)`} id={b.id} data-b={b.id} set:html={html(b.text)} />
                              {place && <span class={k.en}>{place.en ? `${place.en}　` : ''}{coord(place.lnglat)}</span>}
                            </>
                          ) : (
                            <>
                              {place?.date && <span class={`mono ${k.no}`}>{place.date}</span>}
                              <h2 class={`${k.h2} scroll-mt-(--toc-top)`} id={b.id} data-b={b.id} set:html={html(b.text)} />
                              {place?.en && <span class={k.en}>{place.en}</span>}
                              {place && <span class="mono mt-0.5 block text-muted-foreground">{coord(place.lnglat)}</span>}
                            </>
                          )}
                        </header>
                      );
                    }
                    case 'quote': return (
                      <blockquote class={k.quote} data-b={b.id}>
                        <Fragment set:html={html(b.text)} />
                        {b.cite && <cite class={k.cite} data-skip>{b.cite}</cite>}
                      </blockquote>
                    );
                    case 'list': {
                      const Tag = b.ordered ? 'ol' : 'ul';
                      return <Tag class={b.ordered ? k.ol : k.ul} data-b={b.id}>{b.items.map((item) => <li class={b.ordered ? k.oli : k.uli} set:html={html(item)} />)}</Tag>;
                    }
                    case 'code': return <pre class={k.pre} data-b={b.id} data-lang={b.lang}><code>{b.code}</code></pre>;
                    default: {
                      const prev = c.blocks[bi - 1];
                      const afterP = prev?.type === 'p'; // 紧跟在另一段后面的段落隔开一点
                      return <p class={isPlaceOnly(b) ? 'place-only' : afterP ? `${k.p} ${k.pp}` : k.p} data-b={b.id} set:html={html((b as { text: Inline }).text)} />;
                    }
                  }
                })}
              </section>
            );
            });
          }
          const b = c.block;
          const pos = at(c, b.h?.y, b.h?.scale);
          switch (b.type) {
            case 'image':
              return (
                <figure class:list={['blk', 'b-single', 'rv', b.layout === 'inline' && 'inset']} data-b={b.id} {...pos}>
                  <Image src={b.src} alt={b.alt} widths={[800, 1200, 1800, 2400]} sizes="100vw" />
                  {b.caption && <figcaption class="mt-2.5 text-meta text-muted-foreground">{b.caption}</figcaption>}
                </figure>
              );
            case 'pair':
              return (
                <figure class="blk b-pair rv" data-b={b.id} {...pos}>
                  <div class="imgs">
                    {b.images.map((im) => <Image src={im.src} alt={im.alt} widths={[600, 900, 1400]} sizes="(max-width: 760px) 50vw, 45vw" />)}
                  </div>
                  {b.images.some((i) => i.caption) && <figcaption class="mt-2.5 text-meta text-muted-foreground">{b.images.map((i) => i.caption).filter(Boolean).join(' / ')}</figcaption>}
                </figure>
              );
            case 'strip':
              return (
                <figure class="blk b-strip rv" data-b={b.id} {...pos}>
                  <div class="strip-vp">
                    <div class="strip-sc">
                      <div class="strip-track">
                        {b.images.map((im) => <Image src={im.src} alt={im.alt} height={900} widths={[600, 900, 1400]} sizes="60vw" style={{ '--s': im.scale, '--o': im.offset }} />)}
                      </div>
                    </div>
                    {b.images.some((i) => i.caption) && <figcaption class="text-meta text-muted-foreground">{b.images.map((i) => i.caption).filter(Boolean).join(' / ')}</figcaption>}
                  </div>
                </figure>
              );
            case 'grid':
              return (
                <figure class="blk b-grid rv" data-b={b.id} {...pos}>
                  <div class="imgs">
                    {b.images.map((im, i) => <Image src={im.src} alt={im.alt} widths={[500, 900, 1400]} sizes={i === 0 ? '66vw' : '33vw'} />)}
                  </div>
                  {b.images.some((i) => i.caption) && <figcaption class="mt-2.5 text-meta text-muted-foreground">{b.images.map((i) => i.caption).filter(Boolean).join(' / ')}</figcaption>}
                </figure>
              );
            case 'free':
              return (
                <div class="blk b-free rv" data-b={b.id} {...pos}>
                  <div class="canvas" style={{ '--ar': b.ar }}>
                    {b.items.map((it, i) =>
                      it.kind === 'image' ? (
                        <Image class="fi" src={it.src} alt={it.alt} widths={[400, 800, 1400]} sizes={`${Math.round(it.w * 100)}vw`} style={{ '--x': it.x, '--y': it.y, '--w': it.w, '--z': it.z, '--i': i }} />
                      ) : (
                        <p class="fnote" style={{ '--x': it.x, '--y': it.y }} set:html={plainHtml(it.text)} />
                      ),
                    )}
                  </div>
                </div>
              );
            case 'map':
              return map ? (
                <div class="blk b-map" data-b={b.id} {...pos}>
                  {b.scope === 'route'
                    ? <RouteMap variant="block" stops={places} track={track} />
                    : b.scope === 'near'
                      ? <RouteMap variant="block" stops={places} scope="stop" stopId={places[c.place >= 0 ? c.place : 0]?.id} />
                      : <RouteMap variant="block" stops={regions[places[c.place >= 0 ? c.place : 0].region].places.map((n) => places[n])} track={regions[places[c.place >= 0 ? c.place : 0].region].line} minSpan={0.4} />}
                </div>
              ) : null;
          }
        })
      }
    </div>
    <div class="h-progress"><i></i></div>
  </div>
</div>

{
  endnotes.length > 0 && (
    <section class="wrap fns mt-[clamp(56px,8vw,96px)] border-t border-t-border pt-[1.2em] pb-0 text-aux leading-[1.8] text-muted-foreground" aria-label={t('notes.all')}>
      <ol class="max-w-[40em]">
        {endnotes.map((f) => (
          <li class="flex items-baseline gap-[.8em]" id={`fn-${f.ref}`}>
            <sup class="nref text-meta text-primary" id={`note-${f.ref}`}>{f.n}</sup>
            <span set:html={html(f.text)} />
          </li>
        ))}
      </ol>
    </section>
  )
}

{
  itinerary && (
    <section class="t-end wrap g pt-[clamp(80px,10vw,140px)] pb-10">
      <h2 class="col-[1/3] border-t border-t-border pt-3.5 text-heading font-normal tracking-[.14em]">{t('travel.itinerary')}</h2>
      {/* 各地点共用一套列：坐标那一栏按最长的坐标定宽，名字栏每行一样宽 */}
      <ol class="itin col-[3/13] grid grid-cols-[5.5em_1fr_auto] gap-x-(--gap) border-t border-t-border narrow:grid-cols-[4.6em_1fr]">
        {
          places.map((p) => (
            <li class="col-span-full grid cursor-pointer grid-cols-subgrid items-baseline border-b border-b-border py-3 transition-[color] duration-300 hover:text-primary">
              <a class="contents" href={`#place-${p.n}`}>
                <span class="meta">{p.date ?? ''}</span>
                <span class="text-item">{p.name}{p.en && <small class="ml-2.5 text-aux text-muted-foreground ">{p.en}</small>}</span>
                <span class="mono text-muted-foreground narrow:hidden">{coord(p.lnglat)}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>
  )
}
