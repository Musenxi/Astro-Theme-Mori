---
import Chevron from './Chevron.astro';
/**
 * 游记正文（框架版，只有竖向读法）：块序列，每块属于一个站点。
 * 站点标题挂在每站第一个文字块上（block.head 可以覆盖）。混合 / 横向读法之后在这个结构上加。
 */
import { Image } from 'astro:assets';
import type { Inline, TravelData } from '../schema/schema.ts';
import { numberNotes, renderInline } from '../lib/inline.ts';
import { coord } from '../lib/geo.ts';
import { pad2 } from '../lib/zh.ts';
import { t, fmt, vertical } from '../lib/i18n.ts';
import RouteMap from './RouteMap.astro';

interface Props {
  travel: TravelData;
}
const { travel } = Astro.props;
const { blocks, stops, notes } = travel;

// 游记里旁注和脚注不分栏：都在文末列成“注”，编号统一
const raw = numberNotes(blocks);
const all = new Map<string, number>();
for (const [ref] of [...raw.side, ...raw.foot]) if (!all.has(ref)) all.set(ref, all.size + 1);
const numbers = { side: all, foot: all };
const html = (spans: Inline) => renderInline(spans, numbers);
const endnotes = [...all].map(([ref, n]) => ({ ref, n, text: notes[ref]?.text ?? [] }));

const stopIndex = new Map(stops.map((s, i) => [s.id, i]));
/** 每个站点第一次出现的块 id（行程表的锚点），和第一个文字块 id（站点标题挂在它上面） */
const firstBlock = new Map<string, string>();
const firstText = new Map<string, string>();
for (const b of blocks) {
  if (!firstBlock.has(b.stop)) firstBlock.set(b.stop, b.id);
  if (b.type === 'text' && !firstText.has(b.stop)) firstText.set(b.stop, b.id);
}

const endStat = travel.facts.find((f) => /里程|距离|全程|里程|距離|総距離|distance|total|mileage/i.test(f.label))?.value ?? t('travel.fallbackStat', { n: stops.length });


// 游记文字块里各种块的样式：横排文字和竖排文字（.v）各一套，渲染时选好，不靠覆盖
const li = 'relative [counter-increment:li]';
const ht = {
  stop: 'mb-3.5',
  no: 'mb-1.5 block text-primary',
  h2: 'mr-3 inline text-chapter font-normal tracking-[.08em]',
  en: 'text-aux text-muted-foreground',
  p: 'text-justify',
  pp: 'mt-[.9em]',
  h3: 'mt-[1.3em] mb-[.5em] text-[1.12em] font-bold tracking-[.08em]',
  quote: "relative my-[1.6em] px-[4.2em] py-[.3em] text-center text-heading leading-[2.1] text-foreground before:absolute before:top-[-.1em] before:left-0 before:w-[.5em] before:text-[6em] before:leading-none before:text-foreground/20 before:[font-family:'Special_Elite',Georgia,serif] before:content-['“'] narrow:px-[1.6em] narrow:before:text-[2.6em]",
  cite: 'mt-[.3em] block text-meta text-muted-foreground',
  ul: 'my-[.9em] [counter-reset:li]',
  ol: 'my-[.9em] [counter-reset:li]',
  uli: `${li} py-[.2em] pl-[1.6em] before:absolute before:top-[1.05em] before:left-0 before:h-px before:w-[.7em] before:bg-muted-foreground before:content-['']`,
  oli: `${li} py-[.2em] pl-[1.6em] before:absolute before:top-[.3em] before:left-0 before:text-meta before:leading-[2] before:text-muted-foreground before:content-[counter(li)]`,
  pre: 'my-[1em] overflow-x-auto rounded-[6px] bg-muted px-[1.1em] py-[.9em] text-soft-foreground [font:.8em/1.75_var(--font-mono)]',
};
const vt = {
  stop: 'm-0 ml-[1.2em]',
  no: 'm-0 ml-[.3em] block font-serif text-meta tracking-[.26em] text-primary',
  h2: 'm-0 block text-chapter font-normal tracking-[.18em]',
  en: 'mr-[.2em] block text-meta tracking-[.04em] text-muted-foreground',
  p: 'text-justify',
  pp: 'm-0 mr-[.9em]',
  h3: 'm-0 mr-[1.1em] text-[1.12em] font-bold tracking-[.08em]',
  quote: 'm-0 mr-[.9em] border-r border-r-primary p-0 pb-[1em] text-soft-foreground',
  cite: 'm-0 mr-[.4em] block text-meta text-muted-foreground ',
  ul: 'm-0 mr-[.9em] [counter-reset:li]',
  ol: 'm-0 mr-[.9em] [counter-reset:li]',
  uli: `${li} border-0 p-0 before:static before:top-[1.05em] before:left-0 before:inline before:h-auto before:w-auto before:bg-transparent before:content-['・']`,
  oli: `${li} border-0 p-0 before:static before:top-[.3em] before:left-0 before:[font-family:inherit] before:text-[1em] before:leading-[inherit] before:text-muted-foreground before:content-[counter(li,cjk-ideographic)_'、']`,
  pre: 'm-0 mt-[.9em] max-h-full w-[22em] overflow-auto rounded-[6px] bg-muted px-[1.1em] py-[.9em] tracking-[0] text-soft-foreground [font:.8em/1.75_var(--font-mono)] [writing-mode:horizontal-tb]',
};

let fig = 0;
const nextFig = () => pad2(++fig);
---

<div class="t-body">
  <div class="t-vp">
    <div class="t-track">
      {
        blocks.map((b) => {
          const stop = stops[stopIndex.get(b.stop)!];
          const si = stopIndex.get(b.stop)!;
          const anchor = firstBlock.get(b.stop) === b.id ? `stop-${b.stop}` : undefined;
          switch (b.type) {
            case 'text': {
              const v = b.writing === 'v' && vertical;
              const head = b.head ?? firstText.get(b.stop) === b.id;
              const k = v ? vt : ht; // 竖排文字和横排文字的行内块样式不同，渲染时就选好
              return (
                <section id={anchor} class:list={['blk', 'b-text', v && 'v tracking-[.12em] leading-[2.05] [writing-mode:vertical-rl]']} data-b={b.id} data-stop={b.stop} style={{ '--y': b.y, '--s': b.scale }}>
                  {head && (
                    <header class={k.stop}>
                      {v ? (
                        <>
                          <span class={k.no}>{fmt.stop(si + 1)}{stop.date ? `　${stop.date}` : ''}</span>
                          <h2 class={k.h2}>{stop.name}</h2>
                          {stop.en && <span class={k.en}>{stop.en}　{coord(stop.lnglat)}</span>}
                        </>
                      ) : (
                        <>
                          <span class={`mono ${k.no}`}>{pad2(si + 1)}{stop.date ? ` · ${stop.date}` : ''}</span>
                          <h2 class={k.h2}>{stop.name}</h2>
                          {stop.en && <span class={k.en}>{stop.en}</span>}
                          <span class="mono mt-0.5 block text-muted-foreground">{coord(stop.lnglat)}</span>
                        </>
                      )}
                    </header>
                  )}
                  {b.paras.map((p, pi) => {
                    switch (p.type) {
                      case 'h': return <h3 class={k.h3} data-b={p.id} set:html={html(p.text)} />;
                      case 'quote': return (
                        <blockquote class={k.quote} data-b={p.id}>
                          <Fragment set:html={html(p.text)} />
                          {p.cite && <cite class={k.cite} data-skip>{p.cite}</cite>}
                        </blockquote>
                      );
                      case 'list': {
                        const Tag = p.ordered ? 'ol' : 'ul';
                        return <Tag class={p.ordered ? k.ol : k.ul} data-b={p.id}>{p.items.map((item) => <li class={p.ordered ? k.oli : k.uli} set:html={html(item)} />)}</Tag>;
                      }
                      case 'code': return <pre class={k.pre} data-b={p.id} data-lang={p.lang}><code>{p.code}</code></pre>;
                      default: {
                        const afterP = pi > 0 && [undefined, 'p'].includes(b.paras[pi - 1].type); // 紧跟在另一段后面的段落隔开一点
                        return <p class={afterP ? `${k.p} ${k.pp}` : k.p} data-b={p.id} set:html={html(p.text)} />;
                      }
                    }
                  })}
                </section>
              );
            }
            case 'single':
              return (
                <figure id={anchor} class:list={['blk', 'b-single', 'rv', b.layout === 'inset' && 'inset']} data-b={b.id} data-stop={b.stop} style={{ '--y': b.y, '--s': b.scale }}>
                  <Image src={b.src} alt={b.alt} widths={[800, 1200, 1800, 2400]} sizes="100vw" />
                  {b.caption && <figcaption class="mt-2.5 flex items-baseline gap-3 text-meta text-muted-foreground"><span class="mono flex-none">{nextFig()}</span>{b.caption}</figcaption>}
                </figure>
              );
            case 'pair':
              return (
                <figure id={anchor} class="blk b-pair rv" data-b={b.id} data-stop={b.stop} style={{ '--y': b.y, '--s': b.scale }}>
                  <div class="imgs">
                    {b.images.map((im) => <Image src={im.src} alt={im.alt} widths={[600, 900, 1400]} sizes="(max-width: 760px) 50vw, 45vw" />)}
                  </div>
                  {b.images.some((i) => i.caption) && <figcaption class="mt-2.5 flex items-baseline gap-3 text-meta text-muted-foreground"><span class="mono flex-none">{nextFig()}</span>{b.images.map((i) => i.caption).filter(Boolean).join(' / ')}</figcaption>}
                </figure>
              );
            case 'strip':
              return (
                <figure id={anchor} class="blk b-strip rv" data-b={b.id} data-stop={b.stop} style={{ '--y': b.y, '--s': b.scale }}>
                  <div class="strip-vp">
                    <div class="strip-sc">
                      <div class="strip-track">
                        {b.images.map((im) => <Image src={im.src} alt={im.alt} height={900} widths={[600, 900, 1400]} sizes="60vw" style={{ '--s': im.scale, '--o': im.offset }} />)}
                      </div>
                    </div>
                    <figcaption class="flex items-baseline gap-3 text-meta text-muted-foreground">
                      <span class="mono flex-none">{nextFig()}</span>
                      {b.images.map((i) => i.caption).filter(Boolean).join(' / ')}
                      <span class="strip-ctl">
                        <button type="button" data-dir="-1" aria-label={t('travel.left')}><Chevron dir="left" /></button>
                        <button type="button" data-dir="1" aria-label={t('travel.right')}><Chevron /></button>
                      </span>
                    </figcaption>
                  </div>
                </figure>
              );
            case 'grid':
              return (
                <figure id={anchor} class="blk b-grid rv" data-b={b.id} data-stop={b.stop} style={{ '--y': b.y, '--s': b.scale }}>
                  <div class="imgs">
                    {b.images.map((im, i) => <Image src={im.src} alt={im.alt} widths={[500, 900, 1400]} sizes={i === 0 ? '66vw' : '33vw'} />)}
                  </div>
                  {b.images.some((i) => i.caption) && <figcaption class="mt-2.5 flex items-baseline gap-3 text-meta text-muted-foreground"><span class="mono flex-none">{nextFig()}</span>{b.images.map((i) => i.caption).filter(Boolean).join(' / ')}</figcaption>}
                </figure>
              );
            case 'free':
              return (
                <div id={anchor} class="blk b-free rv" data-b={b.id} data-stop={b.stop} style={{ '--y': b.y, '--s': b.scale }}>
                  <div class="canvas" style={{ '--ar': b.ar }}>
                    {b.items.map((it, i) =>
                      it.kind === 'image' ? (
                        <Image class="fi" src={it.src} alt={it.alt} widths={[400, 800, 1400]} sizes={`${Math.round(it.w * 100)}vw`} style={{ '--x': it.x, '--y': it.y, '--w': it.w, '--z': it.z, '--i': i }} />
                      ) : (
                        <p class="fnote" style={{ '--x': it.x, '--y': it.y }} set:html={html(it.text)} />
                      ),
                    )}
                  </div>
                </div>
              );
            case 'map':
              return (
                <div id={anchor} class="blk b-map" data-b={b.id} data-stop={b.stop} style={{ '--y': b.y, '--s': b.scale }}>
                  <RouteMap variant="block" stops={stops} track={travel.track} scope={b.scope} stopId={b.stop} />
                </div>
              );
          }
        })
      }
      <div class="blk b-endcard" data-stop={stops[stops.length - 1].id}>
        <span class="meta">{t('travel.total')}</span>
        <span class="text-num tracking-[.04em] text-foreground">{endStat}</span>
        <span>{t('travel.endNote')}</span>
      </div>
    </div>
    <div class="h-progress"><i></i></div>
  </div>
</div>

{
  endnotes.length > 0 && (
    <section class="wrap fns mt-[clamp(56px,8vw,96px)] border-t border-t-border pt-[1.2em] pb-0 text-aux leading-[1.8] text-muted-foreground" aria-label={t('notes.all')}>
      <ol class="max-w-[40em]">
        {endnotes.map((f) => (
          <li class="flex items-baseline gap-[.8em]" id={`fn-${f.ref}`}>
            <sup class="nref text-meta text-primary" id={`note-${f.ref}`}>{f.n}</sup>
            <span set:html={html(f.text)} />
          </li>
        ))}
      </ol>
    </section>
  )
}

<section class="t-end wrap g pt-[clamp(80px,10vw,140px)] pb-10">
  <h2 class="col-[1/3] border-t border-t-border pt-3.5 text-heading font-normal tracking-[.14em]">{t('travel.itinerary')}</h2>
  {/* 各站共用一套列：坐标那一栏按最长的坐标定宽，站名栏每行一样宽 */}
  <ol class="itin col-[3/13] grid grid-cols-[3em_5.5em_1fr_auto] gap-x-(--gap) border-t border-t-border narrow:grid-cols-[2.2em_4.6em_1fr]">
    {
      stops.map((s, i) => (
        <li class="col-span-full grid cursor-pointer grid-cols-subgrid items-baseline border-b border-b-border py-3 transition-[color] duration-300 hover:text-primary">
          <a class="contents" href={`#stop-${s.id}`}>
            <span class="meta">{pad2(i + 1)}</span>
            <span class="meta">{s.date ?? ''}</span>
            <span class="text-item">{s.name}{s.en && <small class="ml-2.5 text-aux text-muted-foreground ">{s.en}</small>}</span>
            <span class="mono text-muted-foreground narrow:hidden">{coord(s.lnglat)}</span>
          </a>
        </li>
      ))
    }
  </ol>
</section>
