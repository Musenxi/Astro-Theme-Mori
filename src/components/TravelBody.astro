---
/**
 * 长卷版式的正文：把文章的块排成“列”（相邻文字一列，图片、地图各自一块），有竖向、混合、横向三种读法。
 * 读到哪个地点由正文里的地点标记决定：每一列记着自己读到第几个地点（data-place），左下角的“当前位置”和行程表都按它走。
 */
import Image from './Photo.astro';
import CodeBlock from './CodeBlock.astro';
import Callout from './Callout.astro';
import Embed from './Embed.astro';
import type { Inline, PostData } from '../schema/schema.ts';
import type { Flow } from '../lib/flow.ts';
import { numberNotes, renderInline, texHtml } from '../lib/inline.ts';
import { axisOf, isPlaceOnly, wrapOf } from '../lib/flow.mjs';
import { coord } from '../lib/geo.ts';
import { t, vertical } from '../lib/i18n.ts';
import RouteMap from './RouteMap.astro';

interface Props {
  post: PostData;
  flow: Flow;
}
const { post, flow } = Astro.props;
const { notes } = post;
const { places, columns, regions, trip } = flow;
const map = post.map && places.length > 0;
const itinerary = map && (post.mapView?.itinerary ?? true);

// 长卷里旁注和脚注不分栏：都在文末列成“注”，编号统一
const raw = numberNotes(post.blocks);
const all = new Map<string, number>();
for (const [ref] of [...raw.side, ...raw.foot]) if (!all.has(ref)) all.set(ref, all.size + 1);
// 正文里的地点按出现顺序编号（和 flow.places 的顺序一致）；自由排布里的小字不算
const counter = { next: 0 };
const numbers = { side: all, foot: all, place: counter };
const html = (spans: Inline) => renderInline(spans, numbers);
const plainHtml = (spans: Inline) => renderInline(spans, { side: all, foot: all });
const endnotes = [...all].map(([ref, n]) => ({ ref, n, text: notes[ref]?.text ?? [] }));

/** 二级标题上标着的地点（有就把英文名、日期、坐标放在标题旁，和以前站点的标题一样） */
const placeOfBlock = (id: string) => places.find((p) => p.block === id);

// 游记文字块里各种块的样式：横排文字和竖排文字（.v）各一套，渲染时选好，不靠覆盖
const li = 'relative [counter-increment:li]';
const ht = {
  stop: 'mb-3.5',
  no: 'mb-1.5 block text-primary',
  h2: 'mr-3 inline text-chapter font-normal tracking-[.08em]',
  en: 'text-aux text-muted-foreground',
  p: 'text-justify',
  pp: 'mt-[.9em]',
  h3: 'mt-[1.3em] mb-[.5em] text-[1.12em] font-bold tracking-[.08em]',
  quote: "relative my-[1.6em] px-[4.2em] py-[.3em] text-center text-heading leading-[2.1] text-foreground before:absolute before:top-[-.1em] before:left-0 before:w-[.5em] before:text-[6em] before:leading-none before:text-foreground/20 before:[font-family:'Special_Elite',Georgia,serif] before:content-['“'] narrow:px-[1.6em] narrow:before:text-[2.6em]",
  cite: 'mt-[.3em] block text-meta text-muted-foreground',
  ul: 'my-[.9em] [counter-reset:li]',
  ol: 'my-[.9em] [counter-reset:li]',
  uli: `${li} py-[.2em] pl-[1.6em] before:absolute before:top-[1.05em] before:left-0 before:h-px before:w-[.7em] before:bg-muted-foreground before:content-['']`,
  oli: `${li} py-[.2em] pl-[1.6em] before:absolute before:top-[.3em] before:left-0 before:text-meta before:leading-[2] before:text-muted-foreground before:content-[counter(li)]`,
  code: 'my-[1em] overflow-hidden rounded-[6px] bg-muted text-(--code-foreground) [--pad:14px] [font:.8em/1.75_var(--font-mono)]',
  pre: 'overflow-x-auto py-[.9em]',
  /** 提示框、公式、网站卡片 */
  box: '',
};
const vt = {
  stop: 'm-0 ml-[1.2em]',
  no: 'm-0 ml-[.3em] block font-serif text-meta tracking-[.26em] text-primary',
  h2: 'm-0 block text-chapter font-normal tracking-[.18em]',
  en: 'mr-[.2em] block text-meta tracking-[.04em] text-muted-foreground',
  p: 'text-justify',
  pp: 'm-0 mr-[.9em]',
  h3: 'm-0 mr-[1.1em] text-[1.12em] font-bold tracking-[.08em]',
  quote: 'm-0 mr-[.9em] border-r border-r-primary p-0 pb-[1em] text-heading text-foreground',
  cite: 'm-0 mr-[.4em] block text-meta text-muted-foreground ',
  ul: 'm-0 mr-[.9em] [counter-reset:li]',
  ol: 'm-0 mr-[.9em] [counter-reset:li]',
  uli: `${li} border-0 p-0 before:static before:top-[1.05em] before:left-0 before:inline before:h-auto before:w-auto before:bg-transparent before:content-['・']`,
  oli: `${li} border-0 p-0 before:static before:top-[.3em] before:left-0 before:[font-family:inherit] before:text-[1em] before:leading-[inherit] before:text-muted-foreground before:content-[counter(li,cjk-ideographic)_'、']`,
  code: 'm-0 mt-[.9em] flex max-h-full w-[22em] flex-col overflow-hidden rounded-[6px] bg-muted tracking-[0] text-(--code-foreground) [--pad:14px] [font:.8em/1.75_var(--font-mono)] [writing-mode:horizontal-tb]',
  pre: 'min-h-0 overflow-auto py-[.9em]',
  box: 'm-0 mt-[.9em] w-[22em] max-w-none tracking-[0] [writing-mode:horizontal-tb]',
};


/** 每一列（块）共有的属性：读到第几个地点；横滚里的上下位置、缩放、和前一块的间距、浮起来的左右位置 */
const at = (c: { place: number; places: number[] }, h?: { y?: number; scale?: number; gap?: number; x?: number }, more?: Record<string, number | undefined>) => ({
  'data-place': c.place >= 0 ? c.place : undefined,
  'data-places': c.places.length ? c.places.join(',') : undefined,
  style: { '--y': h?.y, '--s': h?.scale, '--k': h?.gap, '--x': h?.x, ...more },
});
/** 一列文字自己的字号、行距、文本框的宽高、竖滚里的左右位置（横滚、竖滚各一份）：有设的才加上类，样式里按读法取 */
const type = (c: { fs?: number; lh?: number; bw?: number; bh?: number; vfs?: number; vlh?: number; vx?: number; vbw?: number; vbh?: number }) => ({
  cls: [c.fs !== undefined && 'fz-h', c.lh !== undefined && 'lz-h', c.bw !== undefined && 'bw-h', c.bh !== undefined && 'bh-h',
    c.vfs !== undefined && 'fz-v', c.vlh !== undefined && 'lz-v', (c.vx !== undefined || c.vbw !== undefined) && 'box-v', c.vbh !== undefined && 'bh-v'],
  style: { '--fz-h': c.fs, '--lz-h': c.lh, '--bw-h': c.bw, '--bh-h': c.bh, '--fz-v': c.vfs, '--lz-v': c.vlh, '--x-v': c.vx, '--bw-v': c.vbw, '--bh-v': c.vbh },
});
/** 竖滚里环绕着文字的单图：后面紧跟着一列（不是标题的）竖滚里横排的文字才环绕 */
type Col = Flow['columns'][number];
const wraps = (c: Col | undefined, next: Col | undefined) => c?.kind === 'block' && !!wrapOf(c.block) && next?.kind === 'text' && !next.head && next.vwriting !== 'v';
/** 竖滚里排过的单图：左边 --x-v、宽 --bw-v（页宽的比例），只设了宽的居中 */
const vbox = (b: { layout?: string; v?: { x?: number; bw?: number } }) => {
  const v = b.v ?? {};
  if (v.bw === undefined && v.x === undefined) return undefined;
  const bw = v.bw ?? (b.layout === 'inline' ? 0.67 : 1);
  return { '--bw-v': bw, '--x-v': v.x ?? (1 - bw) / 2 };
};
/** 上下出血铺满整屏的图（横滚里） */
const bleed = (b: { h?: { bleed?: boolean } }) => b.h?.bleed && 'bleed';
---

<div class="t-body">
      {(() => {
        const col = (c: Flow['columns'][number]) => {
          if (c.kind === 'text') {
            const ci = columns.indexOf(c), before = columns[ci - 1];
            const wrapped = wraps(before, c) && before?.kind === 'block' ? before.block : undefined;
            // 同一列在横滚和竖滚里写法不同（比如横滚里竖排、竖滚里横排）就渲染两份，按读法显示其中一份
            const same = c.writing === c.vwriting && c.align === c.valign && c.pos === c.vpos;
            const start = counter.next;
            return (same ? [{ axis: '', w: c.writing }] : [{ axis: 'h', w: c.writing }, { axis: 'v', w: c.vwriting }]).map((variant) => {
            counter.next = start;
            const v = variant.w === 'v' && vertical;
            const k = v ? vt : ht; // 竖排文字和横排文字的行内块样式不同，渲染时就选好
            return (
              <section class:list={['blk', 'b-text', c.head && 'b-head', c.anchor && 'anchor', variant.axis && `ax-${variant.axis}`, v && 'v tracking-[.12em] leading-[2.05] [writing-mode:vertical-rl]', ...type(c).cls]} data-align={variant.axis === 'v' ? c.valign : c.align} data-pos={variant.axis === 'v' ? c.vpos : c.pos} {...at(c, c, type(c).style)}>
                {wrapped && wrapped.type === 'image' && variant.axis !== 'h' && variant.w !== 'v' && (
                  <figure class="wfig rv" data-side={wrapOf(wrapped)} data-b={wrapped.id} style={{ '--bw-v': axisOf(wrapped, 'v').bw }}>
                    <Image src={wrapped.src} alt={wrapped.alt} widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 40vw" />
                    {wrapped.caption && <figcaption class="mt-2 text-meta text-muted-foreground">{wrapped.caption}</figcaption>}
                  </figure>
                )}
                {c.blocks.map((b, bi) => {
                  switch (b.type) {
                    case 'h': {
                      if (b.level === 3) return <h3 class={`${k.h3} scroll-mt-(--toc-top)`} id={b.id} data-b={b.id} set:html={html(b.text)} />;
                      const place = placeOfBlock(b.id);
                      return (
                        <header class={k.stop}>
                          {v ? (
                            <>
                              {place?.date && <span class={k.no}>{place.date}</span>}
                              <h2 class={`${k.h2} scroll-mt-(--toc-top)`} id={b.id} data-b={b.id} set:html={html(b.text)} />
                              {place && <span class={k.en}>{place.en ? `${place.en}　` : ''}{coord(place.lnglat)}</span>}
                            </>
                          ) : (
                            <>
                              {place?.date && <span class={`mono ${k.no}`}>{place.date}</span>}
                              <h2 class={`${k.h2} scroll-mt-(--toc-top)`} id={b.id} data-b={b.id} set:html={html(b.text)} />
                              {place?.en && <span class={k.en}>{place.en}</span>}
                              {place && <span class="mono mt-0.5 block text-muted-foreground">{coord(place.lnglat)}</span>}
                            </>
                          )}
                        </header>
                      );
                    }
                    case 'quote': return (
                      <blockquote class={k.quote} data-b={b.id}>
                        <Fragment set:html={html(b.text)} />
                        {b.cite && <cite class={k.cite} data-skip>{b.cite}</cite>}
                      </blockquote>
                    );
                    case 'list': {
                      const Tag = b.ordered ? 'ol' : 'ul';
                      return <Tag class={b.ordered ? k.ol : k.ul} data-b={b.id}>{b.items.map((item) => <li class={b.ordered ? k.oli : k.uli} set:html={html(item)} />)}</Tag>;
                    }
                    case 'code': return <CodeBlock id={b.id} code={b.code} lang={b.lang} filename={b.filename} highlight={b.highlight} box={k.code} pre={k.pre} />;
                    case 'callout': return <Callout id={b.id} kind={b.kind} paras={b.text.map(html)} class={k.box} />;
                    case 'math': return <div class={`math-block ${k.box}`} data-b={b.id} set:html={texHtml(b.tex, true)} />;
                    case 'embed': return <Embed id={b.id} url={b.url} class={k.box} code={{ box: k.code, pre: k.pre }} />;
                    default: {
                      const prev = c.blocks[bi - 1];
                      const afterP = prev?.type === 'p'; // 紧跟在另一段后面的段落隔开一点
                      return <p class={isPlaceOnly(b) ? 'place-only' : afterP ? `${k.p} ${k.pp}` : k.p} data-b={b.id} set:html={html((b as { text: Inline }).text)} />;
                    }
                  }
                })}
              </section>
            );
            });
          }
          const b = c.block;
          const pos = at(c, b.h);
          switch (b.type) {
            case 'image': {
              const box = vbox(b);
              return (
                <figure class:list={['blk', 'b-single', 'rv', b.layout === 'inline' && 'inset', bleed(b), box && 'box-v', wraps(c, columns[columns.indexOf(c) + 1]) && 'wrapped']} data-b={b.id} {...at(c, b.h, box)}>
                  <Image src={b.src} alt={b.alt} widths={[800, 1200, 1800, 2400]} sizes="100vw" />
                  {b.caption && <figcaption class="mt-2.5 text-meta text-muted-foreground">{b.caption}</figcaption>}
                </figure>
              );
            }
            case 'pair':
              return (
                <figure class:list={['blk b-pair rv', bleed(b)]} data-b={b.id} {...pos}>
                  <div class="imgs">
                    {b.images.map((im) => <figure><Image src={im.src} alt={im.alt} widths={[600, 900, 1400]} sizes="(max-width: 760px) 50vw, 45vw" />{im.caption && <figcaption class="mt-2 text-meta text-muted-foreground">{im.caption}</figcaption>}</figure>)}
                  </div>
                </figure>
              );
            case 'strip':
              return (
                <figure class:list={['blk b-strip rv', bleed(b)]} data-b={b.id} {...pos}>
                  <div class="strip-vp">
                    <div class="strip-sc">
                      <div class="strip-track">
                        {/* 每张图的左下角是第几张 / 共几张，后面接图注 */}
                        {b.images.map((im, i) => <figure style={{ '--s': im.scale, '--o': im.offset }}><Image src={im.src} alt={im.alt} height={900} widths={[600, 900, 1400]} sizes="60vw" /><figcaption class="mt-2 flex items-baseline gap-3 text-meta text-muted-foreground"><span class="mono flex-none">{i + 1}/{b.images.length}</span>{im.caption}</figcaption></figure>)}
                      </div>
                    </div>
                  </div>
                </figure>
              );
            case 'grid':
              return (
                <figure class:list={['blk b-grid rv', bleed(b)]} data-b={b.id} {...pos}>
                  <div class="imgs">
                    {b.images.map((im, i) => <figure><Image src={im.src} alt={im.alt} widths={[500, 900, 1400]} sizes={i === 0 ? '66vw' : '33vw'} />{im.caption && <figcaption class="mt-2 text-meta text-muted-foreground">{im.caption}</figcaption>}</figure>)}
                  </div>
                </figure>
              );
            case 'free':
              return (
                <div class:list={['blk b-free rv', bleed(b)]} data-b={b.id} {...pos}>
                  <div class="canvas" style={{ '--ar': b.ar }}>
                    {b.items.map((it, i) =>
                      it.kind === 'image' ? (
                        <Image class="fi" src={it.src} alt={it.alt} widths={[400, 800, 1400]} sizes={`${Math.round(it.w * 100)}vw`} style={{ '--x': it.x, '--y': it.y, '--w': it.w, '--z': it.z, '--i': i }} />
                      ) : (
                        <p class:list={['fnote', it.writing === 'h' && 'h']} style={{ '--x': it.x, '--y': it.y, '--w': it.w ?? 0.3 }} set:html={plainHtml(it.text)} />
                      ),
                    )}
                  </div>
                </div>
              );
            case 'map':
              return map ? (
                <div class="blk b-map" data-b={b.id} {...pos}>
                  {b.scope === 'route'
                    ? <RouteMap variant="block" stops={places} track={trip.line} />
                    : b.scope === 'near'
                      ? <RouteMap variant="block" stops={places} scope="stop" stopId={places[c.place >= 0 ? c.place : 0]?.id} />
                      : <RouteMap variant="block" stops={regions[places[c.place >= 0 ? c.place : 0].region].places.map((n) => places[n])} track={regions[places[c.place >= 0 ? c.place : 0].region].line} minSpan={0.4} />}
                </div>
              ) : null;
          }
        };
        /** 浮起来的块（横滚里不占位置、按 x 挪）：包一层零宽的占位，竖滚里这层不起作用 */
        const floated = (x: number | undefined, node: unknown) => (x === undefined ? node : <div class="fslot">{node}</div>);
        // 标题和紧跟着的那列文字挨着排（.hgroup）：标题没设上下位置就和文字一起挪，顶端对齐
        const reel = (cols: Flow['columns']) => {
        const out = [];
        for (let i = 0; i < cols.length; i++) {
          const c = cols[i], t = cols[i + 1];
          if (c.kind === 'text' && c.lead && t?.kind === 'text') {
            i++;
            out.push(
              <div class:list={['hgroup', c.y !== undefined && 'own', t.writing === 'v' && 'tv', c.writing !== 'v' && 'hh', c.vwriting === 'v' && t.vwriting === 'v' && 'vv']} data-pos={t.vpos} style={{ '--y': t.y, '--k': c.gap ?? t.gap }}>
                {col(c)}{col(t)}
              </div>,
            );
          } else out.push(floated(c.kind === 'text' ? c.x : c.block.h?.x, col(c)));
        }
        return out;
        };
        /**
         * 幕间：一屏的停顿，作者在一张画布上随意摆的文字和图片，滚进来时按顺序一样一样落下
         * （scripts/travel.ts 按滚动进度给每样东西 --e，--d 是它开始落下的进度）
         */
        const interlude = (c: Extract<Flow['columns'][number], { kind: 'block' }>) => {
          const b = c.block as Extract<PostData['blocks'][number], { type: 'interlude' }>;
          const n = b.items.length;
          // 东西越多，一样接一样落得越密，最后一样总在钉住的那一屏走完前落好
          const d = (i: number) => (n > 1 ? 0.06 + (i / (n - 1)) * Math.min(0.5, 0.12 * (n - 1)) : 0.1);
          return (
            <section class="t-inter" data-b={b.id} {...at(c)}>
              <div class="ti-stage">
                <div class="ti-canvas" style={{ '--ar': b.ar }}>
                  {b.items.map((it, i) => {
                    const style = { '--x': it.x, '--y': it.y, '--w': it.w, '--rot': it.rot !== undefined ? `${it.rot}deg` : undefined, '--d': d(i) };
                    if (it.kind === 'text') return <p class:list={['ti-it ti-a ti-text', it.writing === 'v' && 'v', it.w === undefined && 'auto']} data-align={it.align} style={{ ...style, '--size': it.size }} set:html={html(it.text)} />;
                    return (
                      <figure class="ti-it ti-a ti-img" style={style}>
                        <Image src={it.src} alt={it.alt} widths={[400, 800, 1200, 1600]} sizes={`${Math.round(it.w * 100)}vw`} />
                        {it.caption && <figcaption class="mt-2 text-meta text-muted-foreground">{it.caption}</figcaption>}
                      </figure>
                    );
                  })}
                </div>
              </div>
            </section>
          );
        };
        // 幕间把横卷分成几段：每段一条自己的横卷，幕间夹在中间竖着滚过
        const parts: Array<{ cols: Flow['columns'] } | { inter: Extract<Flow['columns'][number], { kind: 'block' }> }> = [];
        let cur: Flow['columns'] = [];
        for (const c of columns) {
          if (c.kind === 'block' && c.block.type === 'interlude') { if (cur.length) parts.push({ cols: cur }); cur = []; parts.push({ inter: c }); }
          else cur.push(c);
        }
        if (cur.length) parts.push({ cols: cur });
        return parts.map((p) => ('cols' in p ? (
          <section class="t-reel">
            <div class="t-vp">
              <div class="t-track">{reel(p.cols)}</div>
            </div>
          </section>
        ) : interlude(p.inter)));
      })()}
  {/* 横向读法：网页底边一根进度线管整篇（几段横卷和中间的幕间），上面一格一格是各章的位置 */}
  <div class="h-progress"><i></i><ol class="h-ticks"></ol></div>
</div>

{
  endnotes.length > 0 && (
    <section class="wrap fns mt-[clamp(56px,8vw,96px)] border-t border-t-border pt-[1.2em] pb-0 text-aux leading-[1.8] text-muted-foreground" aria-label={t('notes.all')}>
      <ol class="max-w-[40em]">
        {endnotes.map((f) => (
          <li class="flex items-baseline gap-[.8em]" id={`fn-${f.ref}`}>
            <sup class="nref text-meta text-primary" id={`note-${f.ref}`}>{f.n}</sup>
            <span set:html={html(f.text)} />
          </li>
        ))}
      </ol>
    </section>
  )
}

{
  itinerary && (
    <section class="t-end wrap g pt-[clamp(80px,10vw,140px)] pb-10">
      <h2 class="col-[1/3] border-t border-t-border pt-3.5 text-heading font-normal tracking-[.14em]">{t('travel.itinerary')}</h2>
      {/* 各地点共用一套列：坐标那一栏按最长的坐标定宽，名字栏每行一样宽 */}
      <ol class="itin col-[3/13] grid grid-cols-[5.5em_1fr_auto] gap-x-(--gap) border-t border-t-border narrow:grid-cols-[4.6em_1fr]">
        {
          places.map((p) => (
            <li class="col-span-full grid cursor-pointer grid-cols-subgrid items-baseline border-b border-b-border py-3 transition-[color] duration-300 hover:text-primary">
              <a class="contents" href={`#place-${p.n}`}>
                <span class="meta">{p.date ?? ''}</span>
                <span class="text-item">{p.name}{p.en && <small class="ml-2.5 text-aux text-muted-foreground ">{p.en}</small>}</span>
                <span class="mono text-muted-foreground narrow:hidden">{coord(p.lnglat)}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>
  )
}
