---
import { t, tn, fmt } from '../lib/i18n.ts';
import config from 'virtual:mori/config';
import { getPages } from '../lib/pages.ts';
import { iconSvg } from '../lib/lucide.ts';
import { getEntries } from '../lib/entries.ts';

// 没有手动设定入口时：内置的几项 + 所有页面；设定过就完全按设定来
const items = config.navCustom ? config.nav : [...config.nav, ...(await getPages()).map((p) => ({ label: p.data.title, href: `/${p.id}/` }))];
// 指向分类总览的入口会带一个下拉：各分类和篇数（没有文章的分类不列）
const hasDrop = items.some((n) => n.href === '/category/');
const entries = hasDrop ? await getEntries() : [];
const drop = config.categories.map((c) => ({ c, count: entries.filter((e) => e.category.id === c.id).length })).filter((s) => s.count > 0);
const glyph = 'size-[19px]';
const actions = config.actions;
const split = config.actionsLayout === 'split';
---

<!-- 页头跨页保留：透镜可以在栏目之间滑动，折射用的滤镜也不必重画 -->
<header class="site group/site pointer-events-none sticky top-0 z-25 grid grid-cols-[1fr_auto_1fr] items-center gap-x-3 pt-[clamp(10px,1.8vw,18px)] pr-(--edge) pl-(--edge) -mb-7 pb-7 [transition:transform_.55s_var(--ease-mori)] *:pointer-events-auto phone:grid-cols-[auto_minmax(0,1fr)_auto] phone:has-[.lg-nav_a:nth-child(5)]:grid-cols-[minmax(0,1fr)_auto] [&.hide]:[transform:translateY(calc(-100%_-_24px))]" id="site" transition:persist="mori-site">
  <svg class="absolute" width="0" height="0" aria-hidden="true"><defs id="lg-defs"></defs></svg>
  <a class="mark justify-self-start text-item font-bold tracking-[.32em] [transition:color_.4s,opacity_.3s] phone:text-aux phone:tracking-[.18em] phone:whitespace-nowrap phone:group-has-[.lg-nav_a:nth-child(5)]/site:absolute phone:group-has-[.lg-nav_a:nth-child(5)]/site:size-px phone:group-has-[.lg-nav_a:nth-child(5)]/site:overflow-hidden phone:group-has-[.lg-nav_a:nth-child(5)]/site:[clip-path:inset(50%)]" href="/">{config.title}</a>
  <nav class="lg lg-nav flex p-1 phone:relative phone:max-w-full phone:justify-self-center phone:overflow-x-auto phone:[scrollbar-width:none] phone:[&::-webkit-scrollbar]:hidden" id="lg-nav" aria-label={t('a11y.mainNav')}>
    <span class="lg-lens" id="lg-lens" aria-hidden="true"></span>
    {items.map((n) => {
      const svg = n.icon ? iconSvg(n.icon, glyph) : null;
      return svg
        ? <a class="relative z-1 grid place-items-center rounded-[999px] px-[clamp(12px,1.4vw,17px)] py-2 text-(--lg-fg) transition-[color] duration-300 hover:text-(--lg-fg-on) aria-[current]:text-(--lg-fg-on) phone:flex-none" href={n.href} title={n.label} aria-label={n.label} set:html={svg} />
        : <a class="relative z-1 rounded-[999px] px-[clamp(12px,1.4vw,17px)] py-2 text-aux leading-[1.3] tracking-[.08em] text-(--lg-fg) transition-[color] duration-300 hover:text-(--lg-fg-on) aria-[current]:text-(--lg-fg-on) phone:flex-none" href={n.href} data-drop={n.href === '/category/' && drop.length ? '' : undefined}>{n.label}</a>;
    })}
  </nav>
  {drop.length > 0 && (
    <div class="lg-drop invisible absolute left-0 z-2 pt-2 opacity-0 pointer-events-none! [transition:opacity_.25s,transform_.45s_cubic-bezier(.34,1.45,.5,1),visibility_0s_.25s] [transform:translateY(-4px)] phone:hidden [&.on]:visible [&.on]:pointer-events-auto! [&.on]:opacity-100 [&.on]:[transform:none] [&.on]:[transition-delay:0s]" id="lg-drop" aria-label={t('nav.category')}>
      <ul class="lg lg-menu min-w-44 p-2">
        {drop.map(({ c, count }) => (
          <li>
            <a class="relative flex items-baseline justify-between gap-6 rounded-[14px] px-3.5 py-2 text-aux leading-[1.3] tracking-[.08em] text-(--lg-fg) [transition:color_.3s,background-color_.3s] hover:bg-(--lg-lens) hover:text-(--lg-fg-on) focus-visible:bg-(--lg-lens) focus-visible:text-(--lg-fg-on)" href={`/category/${c.id}/`}>
              <span>{c.zh}</span>
              <span class="meta">{tn('count', count, { n: fmt.num(count) })}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
  {actions.length > 0 && (
    <div class:list={['flex justify-self-end', split ? 'gap-2' : 'lg lg-btn']} id="lg-actions">
      {actions.map((a) => {
        const cls = (split ? 'lg lg-btn ' : '') + 'grid h-[39px] min-w-[39px] place-items-center text-meta text-(--lg-fg) [transition:color_.3s,transform_.4s_cubic-bezier(.34,1.45,.5,1)] hover:text-(--lg-fg-on) active:[transform:scale(.92)]';
        if (a.type === 'theme') {
          const icon = a.style === 'icon';
          return <button class={cls} id="theme" data-mode={icon ? 'icon' : 'text'} type="button" title={t('theme.toggle')} aria-label={t('theme.toggle')}>{icon ? <Fragment><span class="grid place-items-center" data-when="light" set:html={iconSvg('moon', glyph)} /><span class="hidden place-items-center" data-when="dark" set:html={iconSvg('sun', glyph)} /></Fragment> : t('theme.toDark')}</button>;
        }
        const svg = a.icon ? iconSvg(a.icon, glyph) : null;
        return svg
          ? <a class={cls} href={a.href} title={a.label} aria-label={a.label} set:html={svg} />
          : <a class={`${cls} px-3`} href={a.href}>{a.label}</a>;
      })}
    </div>
  )}
</header>
