---
import { t, tn, lang, fmt } from '../../lib/i18n.ts';
import config from 'virtual:mori/config';
import Base from '../../layouts/Base.astro';
import PostHeader from '../../components/PostHeader.astro';
import Chevron from '../../components/Chevron.astro';
import { getEntries } from '../../lib/entries.ts';

const entries = await getEntries();
const cats = config.categories
  .map((c) => ({ c, count: entries.filter((e) => e.category.id === c.id).length }))
  .filter((s) => s.count > 0);
---

<Base title={t('nav.category')}>
  <main data-page="category-index">
    <PostHeader title={t('nav.category')} />
    <div class="wrap g pb-28">
      <ol class="col-[3/11]">
        {
          cats.map(({ c, count }) => (
            <li>
              <a class="group grid grid-cols-[1fr_auto] items-baseline gap-x-5 border-t border-t-border py-6" href={`/category/${c.id}/`}>
                <span class="flex flex-wrap items-baseline gap-x-4">
                  <h2 class="text-heading font-normal tracking-[.14em] transition-[color] duration-300 group-hover:text-primary">{c.zh}</h2>
                  {c.en && lang !== 'en' && <em class="text-item font-light text-muted-foreground">{c.en}</em>}
                </span>
                <span class="meta transition-[color] duration-300 group-hover:text-primary">{tn('count', count, { n: fmt.num(count) })}<Chevron /></span>
              </a>
            </li>
          ))
        }
      </ol>
      {cats.length === 0 && <p class="col-[3/11] text-muted-foreground">{t('empty.all')}</p>}
    </div>
  </main>
</Base>
