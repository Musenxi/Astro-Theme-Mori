---
import Base from '../layouts/Base.astro';
import PostHeader from '../components/PostHeader.astro';
import PostBody from '../components/PostBody.astro';
import Friends from '../components/Friends.astro';
import Comments from '../components/Comments.astro';
import { getPages } from '../lib/pages.ts';
import type { PageEntry } from '../lib/pages.ts';
import { RESERVED_SLUGS } from '../schema/schema.ts';

// 页面的网址是 /<文件名>/。和站点自带的地址重名的要提前报错，别悄悄被盖掉
export async function getStaticPaths() {
  return (await getPages({ hidden: true })).map((p) => {
    if (RESERVED_SLUGS.includes(p.id)) throw new Error(`页面“${p.data.title}”的文件名 “${p.id}” 和站点自带的地址重名，请改一个名字（不能用：${RESERVED_SLUGS.join('、')}）`);
    return { params: { page: p.id }, props: { page: p } };
  });
}

const { page } = Astro.props as { page: PageEntry };
const d = page.data;
---

<Base title={d.title} description={d.excerpt || undefined}>
  <main data-page="page">
    <PostHeader title={d.title} sub={d.subtitle || undefined} center />
    {d.blocks.length > 0 && <PostBody blocks={d.blocks} notes={d.notes} />}
    {d.template === 'friends' && <Friends />}
    {d.comments && <Comments entry={`pages/${page.id}`} />}
  </main>
</Base>
