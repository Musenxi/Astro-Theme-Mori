---
/**
 * 地图：全站带定位的照片、游记的地点和路线，落在街道底图上（Atlas.astro）。整屏，页头浮在上面，不要页脚。
 */
import Base from '../layouts/Base.astro';
import Atlas from '../components/Atlas.astro';
import { t } from '../lib/i18n.ts';
import { getAtlas } from '../lib/atlas.ts';
import '../styles/atlas.css';

const atlas = await getAtlas();
---

<Base title={t('nav.map')} bare>
  <main class="fixed inset-0 z-0 bg-background" data-page="map">
    <Atlas atlas={atlas} variant="page" />
  </main>
</Base>

<script>
  import '../scripts/atlas.ts';
</script>
