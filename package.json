{
  "name": "astro-mori-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "pnpm --parallel --filter demo --filter mori-comments --filter mori-studio dev",
    "build": "pnpm --filter demo build",
    "preview": "pnpm --filter demo preview",
    "check": "pnpm -r --if-present check",
    "studio": "pnpm --filter demo studio",
    "test": "pnpm -r --if-present test",
    "comments": "pnpm --filter mori-comments dev",
    "site": "pnpm --filter demo dev"
  }
}
