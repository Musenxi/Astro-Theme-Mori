{
  "name": "astro-mori-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "node scripts/site.mjs pnpm --parallel --filter {site} --filter mori-comments --filter mori-studio dev",
    "build": "node scripts/site.mjs pnpm --filter {site} build",
    "preview": "node scripts/site.mjs pnpm --filter {site} preview",
    "check": "node scripts/site.mjs pnpm --filter {site} exec astro sync && pnpm -r --if-present check",
    "studio": "node scripts/site.mjs pnpm --filter {site} studio",
    "test": "pnpm -r --if-present test",
    "comments": "pnpm --filter mori-comments dev",
    "site": "node scripts/site.mjs pnpm --filter {site} dev",
    "lint": "pnpm -r --if-present lint"
  }
}
