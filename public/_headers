# Cloudflare（Pages、Workers 的静态资源）读这个文件。/feed 没有扩展名，明确告诉阅读器和浏览器它是 RSS。
/feed
  Content-Type: application/rss+xml; charset=utf-8
/rss.xml
  Content-Type: application/rss+xml; charset=utf-8
# 构建出来的文件名带哈希，永远不会变
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
# 东观体：woff2 的文件名是内容哈希，font.css 的地址带内容哈希，一年
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
