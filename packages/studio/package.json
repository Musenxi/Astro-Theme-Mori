{
  "name": "mori-studio",
  "version": "0.0.1",
  "description": "MORI Studio — 本地写作与排版编辑器（读写项目里的内容文件，不需要 git）。",
  "license": "GPL-3.0-only",
  "type": "module",
  "bin": {
    "mori-studio": "./bin/mori-studio.mjs"
  },
  "files": [
    "bin",
    "src",
    "dist"
  ],
  "scripts": {
    "start": "node bin/mori-studio.mjs",
    "test": "node --test test/*.test.mjs",
    "build:editor": "node scripts/build-editor.mjs",
    "dev": "node bin/mori-studio.mjs --dev --root ../../examples/demo",
    "dev:ui": "vite --config app/vite.config.ts",
    "build:ui": "vite build --config app/vite.config.ts",
    "check:ui": "tsc -p app"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.104.0",
    "astro-mori": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exif-reader": "^2.0.3",
    "htm": "^3.1.1",
    "lucide-react": "^1.48.0",
    "preact": "^10.29.8",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
