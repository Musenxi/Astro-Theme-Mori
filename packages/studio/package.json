{
  "name": "mori-studio",
  "version": "0.0.1",
  "description": "MORI Studio — 本地写作与排版编辑器（读写项目里的内容文件，不需要 git）。",
  "license": "GPL-3.0-only",
  "type": "module",
  "bin": {
    "mori-studio": "./bin/mori-studio.mjs"
  },
  "files": [
    "bin",
    "src",
    "ui"
  ],
  "scripts": {
    "start": "node bin/mori-studio.mjs",
    "test": "node --test test/*.test.mjs",
    "build:editor": "node scripts/build-editor.mjs",
    "dev": "node bin/mori-studio.mjs --dev --root ../../examples/demo"
  },
  "dependencies": {
    "astro-mori": "workspace:*",
    "exif-reader": "^2.0.3",
    "htm": "^3.1.1",
    "preact": "^10.29.8",
    "sharp": "^0.35.5",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "esbuild": "^0.28.2"
  }
}
