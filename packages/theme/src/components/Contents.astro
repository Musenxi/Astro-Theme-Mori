---
import Chevron from './Chevron.astro';
/** 目次（spec §2，作者认可）：左边大字“目次 / Contents”和编者按，右边按分类分组 */
import config from 'virtual:mori/config';
import type { Entry } from '../lib/entries.ts';
import { dotDate, pad3 } from '../lib/zh.ts';
import { t, tn, fmt } from '../lib/i18n.ts';

interface Props {
  entries: Entry[];
  latest: Entry;
}
const { entries } = Astro.props;
const ROMAN = ['Ⅰ', 'Ⅱ', 'Ⅲ', 'Ⅳ', 'Ⅴ', 'Ⅵ', 'Ⅶ', 'Ⅷ', 'Ⅸ', 'Ⅹ'];
const sections = config.categories
  .map((c) => ({ c, list: entries.filter((e) => e.category.id === c.id) }))
  .filter((s) => s.list.length)
  .map((s, i) => ({ ...s, roman: ROMAN[i] ?? String(i + 1) }));
---

<section class="wrap fcon">
  <header class="f-run mono">
    <span>{config.title}</span>
    <span>{t('toc.run')}</span>
  </header>
  <div class="g fcon-body">
    <aside class="f-ed">
      <h2 class="f-toc">{t('toc.title')}{t('toc.sub') && <em>{t('toc.sub')}</em>}</h2>
      {config.home.editorNote && <p class="f-note"><span class="mono">{t('toc.editor')}</span>{config.home.editorNote}</p>}
    </aside>
    <div class="f-secs">
      {
        sections.map(({ c, list, roman }) => (
          <section class="f-sec">
            <a class="f-sh" href={`/category/${c.id}/`}>
              <span class="rn">{roman}</span>
              <h3>{c.zh}</h3>
              <em>{c.en}</em>
              <span class="ct mono">{tn('count', list.length, { n: fmt.num(list.length) })}<Chevron /></span>
            </a>
            <ol class="f-en">
              {list.map((e) => (
                <li>
                  <a href={e.href}>
                    <span class="pn">{pad3(e.n)}</span>
                    <span class="tt">{e.data.title}</span>
                    <span class="dt mono">{dotDate(e.data.date)}</span>
                    <span class="ex">{e.data.excerpt}</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </div>
</section>
