---
import { t } from '../lib/i18n.ts';
import type { Entry } from '../lib/entries.ts';
interface Props {
  older?: Entry;
  newer?: Entry;
}
const { older, newer } = Astro.props;
---

<nav class="wrap g post-end" aria-label={t('post.nav')}>
  {older ? <a href={older.href}><span class="mono lbl">{t('post.prev')}</span><span class="ul">{older.data.title}</span></a> : <span />}
  {newer ? <a href={newer.href}><span class="mono lbl">{t('post.next')}</span><span class="ul">{newer.data.title}</span></a> : <span />}
</nav>
