---
import { t } from '../lib/i18n.ts';
/**
 * 文末评论区（spec §5.3）：进入视口才加载，不拖慢首屏；每次换页都用新的 entry 重新加载。
 * provider 为 mori 时是自建评论（文末评论 + 划词引用评论）；其余是第三方（只有文末评论）。
 */
import config from 'virtual:mori/config';
import { avatarTemplate } from '../lib/avatar.mjs';

interface Props {
  /** 评论按文章归档：posts/<id>（普通文章和游记都在 posts 下） */
  entry: string;
}
const { entry } = Astro.props;
const c = config.comments;
// 前端拿到的是已经解析好的头像地址模板（空字符串 = 不显示头像）
const pub = c?.provider === 'mori' ? { ...c, avatar: avatarTemplate(c.avatar) } : c;
---

{
  c && (
    <section class="wrap g pt-[clamp(24px,4vw,48px)] pb-[clamp(40px,6vw,72px)]" id="comments" data-entry={entry} data-provider={c.provider} data-config={JSON.stringify(pub)}>
      <header class="col-[3/11] mb-5 flex items-baseline gap-3 border-t border-t-border pt-8"><h2 class="text-section font-normal tracking-[.14em]">{t('comments.title')}</h2><span class="meta" data-count></span></header>
      <div class="col-[3/11]" data-body></div>
    </section>
  )
}
<script>
  import '../scripts/comments.ts';
  import '../scripts/annotate.ts';
</script>
