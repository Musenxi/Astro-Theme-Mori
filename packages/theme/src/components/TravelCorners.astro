---
/**
 * 游记的两个角落控件（玻璃）：右下角读法切换（竖 / 横 / 混），左下角当前位置。
 * 读者选读法并被记住；作者只决定默认值和允许哪几种（reading.default / allowed）。
 */
import type { TravelData } from '../content/schema.ts';
import RouteMap from './RouteMap.astro';
import { t } from '../lib/i18n.ts';

interface Props {
  allowed: Array<'v' | 'h' | 'm'>;
  stops: TravelData['stops'];
  track?: TravelData['track'];
}
const { allowed, stops, track } = Astro.props;
const LABEL = { v: [t('travel.mode.v'), t('travel.modeLabel.v')], h: [t('travel.mode.h'), t('travel.modeLabel.h')], m: [t('travel.mode.m'), t('travel.modeLabel.m')] } as const;
const stopData = stops.map((s) => ({ id: s.id, name: s.name, date: s.date ?? '' }));
---

{
  allowed.length > 1 && (
    <div class="corner mc glass" id="mc" role="group" aria-label={t('travel.readingGroup')} data-modes={allowed.join(',')}>
      <i />
      {allowed.map((m) => <button type="button" data-m={m} aria-label={LABEL[m][1]}>{LABEL[m][0]}</button>)}
      <span class="tip" id="mc-tip">{t('travel.readingGroup')}</span>
    </div>
  )
}

<div class="corner loc glass" id="loc" data-stops={JSON.stringify(stopData)}>
  <RouteMap variant="mini" stops={stops} track={track} />
  <div class="where">
    <span class="mono" id="rb-n">01 / {String(stops.length).padStart(2, '0')}</span>
    <b id="rb-name">{stops[0].name}</b>
  </div>
</div>
