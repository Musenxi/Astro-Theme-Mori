---
import { t } from '../lib/i18n.ts';
/** 看大图（spec §4）：点任意正文图片，图片从原位放大，原来的裁切同步展开；背景是磨砂玻璃 */
---

<div class="lb" id="lb" hidden>
  <img class="lb-img" alt="" />
  <div class="lb-cap glass"><span class="mono" id="lb-n"></span><span id="lb-t"></span><span class="mono lbl">{t('lightbox.close')}</span></div>
</div>
