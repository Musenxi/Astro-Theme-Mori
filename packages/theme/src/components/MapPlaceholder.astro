---
/** 地图的占位：先把版面留出来，剪影地图（d3-geo 构建期生成 SVG）最后做 */
import type { TravelData } from '../content/schema.ts';
interface Props {
  stops: TravelData['stops'];
}
const { stops } = Astro.props;
---

<div class="map-ph" role="img" aria-label={`路线：${stops.map((s) => s.name).join('、')}`}>
  <span class="mono">{stops.map((s) => s.en ?? s.name).join(' → ')}</span>
</div>
<style>
  .map-ph{aspect-ratio:1000/720;display:grid;place-items:center;padding:24px;border:1px solid var(--rule);color:var(--ink-3);text-align:center}
</style>
