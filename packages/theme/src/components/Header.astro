---
import { t } from '../lib/i18n.ts';
import config from 'virtual:mori/config';
import { getPages } from '../lib/pages.ts';

// 没有手动设定入口时：内置的几项 + 所有页面；设定过就完全按设定来
const items = config.navCustom ? config.nav : [...config.nav, ...(await getPages()).map((p) => ({ label: p.data.title, href: `/${p.id}/` }))];
---

<!-- 页头跨页保留：透镜可以在栏目之间滑动，折射用的滤镜也不必重画 -->
<header class="site group/site pointer-events-none sticky top-0 z-25 grid grid-cols-[1fr_auto_1fr] items-center gap-x-3 pt-[clamp(10px,1.8vw,18px)] pr-(--edge) pl-(--edge) [transition:transform_.55s_var(--ease-mori)] *:pointer-events-auto phone:grid-cols-[auto_minmax(0,1fr)_auto] phone:has-[.lg-nav_a:nth-child(5)]:grid-cols-[minmax(0,1fr)_auto] [&.hide]:[transform:translateY(calc(-100%_-_24px))]" id="site" transition:persist="mori-site">
  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs id="lg-defs"></defs></svg>
  <a class="mark justify-self-start text-[19px] font-bold tracking-[.32em] [transition:color_.4s,opacity_.3s] [view-transition-name:site-mark] [.site.on-cover_&]:text-background phone:text-[15px] phone:tracking-[.18em] phone:whitespace-nowrap phone:group-has-[.lg-nav_a:nth-child(5)]/site:absolute phone:group-has-[.lg-nav_a:nth-child(5)]/site:size-px phone:group-has-[.lg-nav_a:nth-child(5)]/site:overflow-hidden phone:group-has-[.lg-nav_a:nth-child(5)]/site:[clip-path:inset(50%)]" href="/">{config.title}</a>
  <nav class="lg lg-nav flex p-1 [view-transition-name:site-nav] phone:relative phone:max-w-full phone:justify-self-center phone:overflow-x-auto phone:[scrollbar-width:none] phone:[&::-webkit-scrollbar]:hidden" id="lg-nav" aria-label={t('a11y.mainNav')}>
    <span class="lg-lens" id="lg-lens" aria-hidden="true"></span>
    {items.map((n) => <a class="relative z-1 rounded-[999px] px-[clamp(12px,1.4vw,17px)] py-2 text-[14.5px] leading-[1.3] tracking-[.08em] text-(--lg-fg) transition-[color] duration-300 hover:text-(--lg-fg-on) aria-[current]:text-(--lg-fg-on) phone:flex-none" href={n.href}>{n.label}</a>)}
  </nav>
  <button class="lg lg-btn theme grid size-[39px] justify-self-end place-items-center text-[13.5px] text-(--lg-fg) [transition:color_.3s,transform_.4s_cubic-bezier(.34,1.45,.5,1)] [view-transition-name:site-theme] hover:text-(--lg-fg-on) active:[transform:scale(.92)]" id="theme" type="button" title={t('theme.toggle')} aria-label={t('theme.toggle')}>{t('theme.toDark')}</button>
</header>
