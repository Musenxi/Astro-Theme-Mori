---
/**
 * 文章目录：所有文章（普通文章和游记），最新的在前，按年份分组。
 * 和“归档”不同：归档是按月份铺开的时间刻度，这里是一页可以直接读下去的目录。
 */
import { t, lang } from '../lib/i18n.ts';
import Base from '../layouts/Base.astro';
import PostHeader from '../components/PostHeader.astro';
import { getEntries } from '../lib/entries.ts';
import { cnNumber, cnYear, pad2 } from '../lib/zh.ts';

const entries = await getEntries();
const years = [...new Set(entries.map((e) => e.data.date.getFullYear()))].sort((a, b) => b - a);
const byYear = years.map((y) => ({ y, list: entries.filter((e) => e.data.date.getFullYear() === y) }));
const zh = lang !== 'en';
---

<Base title={t('nav.posts')}>
  <main data-page="posts">
    <PostHeader title={t('nav.posts')} kicker={zh ? `共 ${cnNumber(entries.length)} 篇` : `${entries.length} pieces`} sub={zh ? 'Posts' : undefined} />
    <div class="wrap g pb-24">
      {
        byYear.map(({ y, list }) => (
          <section class="grid grid-cols-[5.2rem_minmax(0,1fr)] gap-x-[clamp(16px,3vw,40px)] border-t border-t-border pt-[26px] pb-2 first:border-t-foreground col-[3/11] narrow:grid-cols-1 narrow:pt-5">
            <h2 class="self-start font-display text-[clamp(28px,3vw,40px)] leading-none font-light tracking-[.02em] text-muted-foreground italic sticky top-[76px] narrow:static narrow:mb-1.5" aria-label={String(y)}>{zh ? cnYear(y) : y}</h2>
            <ol>
              {list.map((e) => (
                <li class="group/row">
                  <a class="group/a grid grid-cols-[3.4rem_minmax(0,1fr)_auto] items-baseline gap-x-[18px] border-b border-b-border-soft py-3.5 group-last/row:border-b-0 narrow:grid-cols-[3rem_minmax(0,1fr)] narrow:gap-y-0.5" href={e.href}>
                    <time class="mono text-muted-foreground" datetime={e.data.date.toISOString().slice(0, 10)}>{pad2(e.data.date.getMonth() + 1)}.{pad2(e.data.date.getDate())}</time>
                    <span class="grid min-w-0 gap-[3px]">
                      <span class="w-fit max-w-full bg-[linear-gradient(currentColor,currentColor)] bg-[position:0_100%] bg-[size:0_1px] bg-no-repeat text-[19px] leading-[1.5] tracking-[.05em] [transition:background-size_.5s_var(--ease-mori),color_.3s] group-hover/a:bg-[size:100%_1px] group-hover/a:text-primary">{e.data.title}</span>
                      {e.data.excerpt && <span class="ex overflow-hidden text-[14px] leading-[1.7] text-ellipsis whitespace-nowrap text-muted-foreground group-hover/a:text-soft-foreground narrow:line-clamp-2 narrow:whitespace-normal">{e.data.excerpt}</span>}
                    </span>
                    <span class="mono whitespace-nowrap text-muted-foreground narrow:col-2">{e.category.zh}{e.kind === 'travel' && e.category.zh !== t('kind.travel') ? ` · ${t('kind.travel')}` : ''}</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
      {entries.length === 0 && <p>{t('empty.all')}</p>}
    </div>
  </main>
</Base>
