---
import { t, lang } from '../lib/i18n.ts';
import config from 'virtual:mori/config';
import Base from '../layouts/Base.astro';
import Scale from '../components/Scale.astro';
import { getEntries } from '../lib/entries.ts';

const all = await getEntries();
const entries = all; // 普通文章和游记都是文章
---

<Base title={t('nav.posts')} direction={config.archive.direction}>
  <main data-page="posts">
    <Scale title={t('nav.posts')} en={lang === 'en' ? undefined : t('posts.sub')} entries={entries} all={all} empty={t('empty.posts')} />
  </main>
</Base>
