---
import config from 'virtual:mori/config';
import Base from '../layouts/Base.astro';
import Listing from '../components/Listing.astro';
import { getEntries } from '../lib/entries.ts';

const entries = (await getEntries()).filter((e) => e.kind === 'travel');
---

<Base title="游记" direction={config.archive.direction}>
  <main data-page="travels">
    <Listing title="游记" en="Journeys" entries={entries} />
  </main>
</Base>
