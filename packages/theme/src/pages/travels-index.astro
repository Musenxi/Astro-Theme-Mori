---
import { t, lang } from '../lib/i18n.ts';
import config from 'virtual:mori/config';
import Base from '../layouts/Base.astro';
import Scale from '../components/Scale.astro';
import { getEntries } from '../lib/entries.ts';

const all = await getEntries();
const entries = all.filter((e) => e.kind === 'travel');
---

<Base title={t('nav.travels')} direction={config.archive.direction}>
  <main data-page="travels">
    <Scale title={t('nav.travels')} en={lang === 'en' ? undefined : t('travels.sub')} entries={entries} all={all} empty={t('empty.travels')} />
  </main>
</Base>
