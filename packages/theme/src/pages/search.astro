---
import { t, lang } from '../lib/i18n.ts';
import config from 'virtual:mori/config';
import Base from '../layouts/Base.astro';
---

<Base title={t('search.title')} direction={config.archive.direction}>
  <main data-page="search" class="wrap g srch">
    <header>
      <a class="he-back mono" href="/">{t('toc.back')}</a>
      <label class="srch-in"><span class="mono lbl">{t('search.title')}</span><input id="q" type="search" placeholder={t('search.placeholder')} autocomplete="off" autofocus /></label>
      <p class="mono lbl" id="srch-note"></p>
    </header>
    <ol class="srch-list" id="srch-list"></ol>
  </main>
  <script>
    import '../scripts/search.ts';
  </script>
</Base>
