---
import Chevron from '../components/Chevron.astro';
import { t, lang } from '../lib/i18n.ts';
import config from 'virtual:mori/config';
import Base from '../layouts/Base.astro';
---

<Base title={t('notfound.title')} direction={config.home.direction}>
  <main data-page="404" class="wrap nf">
    <p class="mono lbl">404</p>
    <h1>{t('notfound.h')}</h1>
    <a class="ul" href="/">{t('notfound.back')}<Chevron /></a>
  </main>
</Base>
<style>
  .nf{padding-top:clamp(80px,18vh,200px);padding-bottom:clamp(80px,18vh,200px)}
  .nf h1{font-size:clamp(28px,3.4vw,48px);font-weight:300;letter-spacing:.08em;line-height:1.5;margin:18px 0 32px}
</style>
