---
import Base from '../layouts/Base.astro';
import TravelBody from '../components/TravelBody.astro';
import MapPlaceholder from '../components/MapPlaceholder.astro';
import EntryNav from '../components/EntryNav.astro';
import { getEntries } from '../lib/entries.ts';
import type { Entry } from '../lib/entries.ts';
import type { TravelData } from '../content/schema.ts';
import { dotDate } from '../lib/zh.ts';

export async function getStaticPaths() {
  const entries = await getEntries();
  return entries.flatMap((e, i) => (e.kind === 'travel' ? [{ params: { slug: e.id }, props: { entry: e, older: entries[i + 1], newer: entries[i - 1] } }] : []));
}

const { entry, older, newer } = Astro.props as { entry: Entry; older?: Entry; newer?: Entry };
const d = entry.data as TravelData;
---

<Base title={d.title} description={d.excerpt} type="article">
  <main data-page="travel">
    <article class="travel" data-mode="v" data-dir={d.reading.direction}>
      <header class="wrap g t-hero">
        <div class="info">
          <div class="kicker mono">{entry.category.zh} · {dotDate(d.date)}</div>
          <h1>{d.title}</h1>
          <p class="ex">{d.excerpt}</p>
          {d.facts.length > 0 && (
            <dl class="facts">
              {d.facts.map((f) => <><dt>{f.label}</dt><dd>{f.value}</dd></>)}
              <dt>站点</dt><dd>{d.stops.length}</dd>
            </dl>
          )}
        </div>
        <div class="mapbox"><MapPlaceholder stops={d.stops} /></div>
      </header>
      <TravelBody travel={d} />
    </article>
    <EntryNav older={older} newer={newer} />
  </main>
  <script>
    import '../scripts/reveal.ts';
  </script>
</Base>
