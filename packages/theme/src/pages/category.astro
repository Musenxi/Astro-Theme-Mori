---
import { t, lang } from '../lib/i18n.ts';
import config from 'virtual:mori/config';
import Base from '../layouts/Base.astro';
import Scale from '../components/Scale.astro';
import { getEntries } from '../lib/entries.ts';

export function getStaticPaths() {
  return config.categories.map((c) => ({ params: { id: c.id }, props: { category: c } }));
}
const { category } = Astro.props;
const all = await getEntries();
const entries = all.filter((e) => e.category.id === category.id);
const roman = ['Ⅰ', 'Ⅱ', 'Ⅲ', 'Ⅳ', 'Ⅴ', 'Ⅵ', 'Ⅶ', 'Ⅷ', 'Ⅸ', 'Ⅹ'][config.categories.findIndex((c) => c.id === category.id)];
---

<Base title={category.zh} direction={config.archive.direction}>
  <main data-page="category">
    <Scale title={category.zh} en={category.en} roman={roman} entries={entries} all={all} empty={category.empty ?? t('empty.default', { name: category.zh })} />
  </main>
</Base>
