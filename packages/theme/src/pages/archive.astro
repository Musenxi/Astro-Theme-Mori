---
import { t, lang } from '../lib/i18n.ts';
import config from 'virtual:mori/config';
import Base from '../layouts/Base.astro';
import Scale from '../components/Scale.astro';
import { getEntries } from '../lib/entries.ts';

const entries = await getEntries();
---

<Base title={t('nav.archive')} direction={config.archive.direction}>
  <main data-page="archive">
    <Scale title={t('archive.title')} en={lang === 'en' ? undefined : t('archive.sub')} entries={entries} all={entries} empty={t('empty.all')} />
  </main>
</Base>
