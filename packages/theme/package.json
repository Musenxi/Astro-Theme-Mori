{
  "name": "astro-mori",
  "version": "0.0.1",
  "description": "MORI — a quiet, editorial Astro blog theme with vertical text and travel journals.",
  "license": "GPL-3.0-only",
  "type": "module",
  "keywords": [
    "astro-integration",
    "astro-theme",
    "blog",
    "vertical-text",
    "withastro"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./content": "./src/content/index.ts",
    "./components/*": "./src/components/*",
    "./layouts/*": "./src/layouts/*",
    "./styles/*": "./src/styles/*",
    "./pages/*": "./src/pages/*",
    "./fonts/*": "./fonts/*",
    "./schema": "./src/content/schema.ts",
    "./validate": "./src/content/validate.ts",
    "./config": "./src/config.ts",
    "./anchor": "./src/lib/anchor-text.ts",
    "./markdown": "./src/lib/markdown.mjs",
    "./avatar": "./src/lib/avatar.mjs",
    "./lucide": "./src/lib/lucide.ts"
  },
  "files": [
    "src",
    "fonts",
    "bin"
  ],
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "d3-geo": "^3.1.1",
    "d3-shape": "^3.2.0",
    "lucide": "^1.49.0",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "bin": {
    "mori-md": "./bin/mori-md.mjs"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.0",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-shape": "^3.2.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@typescript-eslint/parser": "^8.71.0",
    "astro": "^7.3.5",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "check": "tsc -p .",
    "test": "node --test test/*.test.ts",
    "lint": "eslint src"
  }
}
